#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
STATE_DIR="${ROOT_DIR}/state"
TX_DIR="${STATE_DIR}/transactions"
LOG_DIR="${STATE_DIR}/logs"
CONFLICT_DIR="${STATE_DIR}/conflicts"
WORK_DIR="${STATE_DIR}/work"
CACHE_WHEELS_DIR="${ROOT_DIR}/cache/wheels"
OPS_DIR="${STATE_DIR}/ops"
CONFIG_FILE="${ROOT_DIR}/config.toml"
CONFIG_TEMPLATE_FILE="${ROOT_DIR}/config.toml.template"
PROJECT_FILE="${ROOT_DIR}/pyproject.toml"
PROJECT_TEMPLATE_FILE="${ROOT_DIR}/pyproject.toml.template"
LOCK_FILE="${ROOT_DIR}/uv.lock"
PLUGINS_FILE="${STATE_DIR}/plugins.json"
PID_FILE="${STATE_DIR}/comfyui.pid"

TX_FILE=""

detect_python_bin() {
    if [ -n "${PYTHON_CMD:-}" ] && command -v "${PYTHON_CMD}" >/dev/null 2>&1; then
        echo "${PYTHON_CMD}"
        return 0
    fi
    if command -v python3 >/dev/null 2>&1; then
        echo "python3"
        return 0
    fi
    if command -v python >/dev/null 2>&1; then
        echo "python"
        return 0
    fi
    return 1
}

PYTHON_BIN="$(detect_python_bin || true)"

timestamp_utc() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

require_python() {
    if [ -z "${PYTHON_BIN}" ]; then
        echo "ERROR: python3/python is required" >&2
        exit 1
    fi
}

require_cmd() {
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "ERROR: command not found: $cmd" >&2
        exit 1
    fi
}

uv_cache_dir() {
    echo "${ROOT_DIR}/cache/uv"
}

config_get() {
    local key="$1"
    local default_value="$2"
    require_python
    "${PYTHON_BIN}" - "$CONFIG_FILE" "$key" "$default_value" <<'PY'
import pathlib
import sys

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print(sys.argv[3])
        raise SystemExit(0)

cfg_path = pathlib.Path(sys.argv[1])
key = sys.argv[2]
default = sys.argv[3]

if not cfg_path.exists():
    print(default)
    raise SystemExit(0)

try:
    data = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
except Exception:
    print(default)
    raise SystemExit(0)

cur = data
for part in key.split('.'):
    if isinstance(cur, dict) and part in cur:
        cur = cur[part]
    else:
        print(default)
        raise SystemExit(0)

if isinstance(cur, bool):
    print("true" if cur else "false")
elif isinstance(cur, (int, float)):
    print(cur)
elif isinstance(cur, list):
    print(",".join(str(x) for x in cur))
elif cur is None:
    print(default)
else:
    print(str(cur))
PY
}

ensure_config_file_for_init() {
    local comfyui_dir_override="${1:-}"
    local python_override="${2:-}"

    if [ ! -f "$CONFIG_FILE" ] && { [ -z "$comfyui_dir_override" ] || [ -z "$python_override" ]; }; then
        echo "ERROR: initial setup requires --comfyui-dir <abs-path> and --python <python-spec>" >&2
        exit 1
    fi

    require_python
    "${PYTHON_BIN}" - "$CONFIG_FILE" "$CONFIG_TEMPLATE_FILE" "$comfyui_dir_override" "$python_override" <<'PY'
import pathlib
import sys

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        tomllib = None

config_path = pathlib.Path(sys.argv[1])
template_path = pathlib.Path(sys.argv[2])
comfyui_override = sys.argv[3].strip()
python_override = sys.argv[4].strip()

DEFAULT_CORE_PACKAGES = [
    "torch",
    "torchvision",
    "torchaudio",
    "xformers",
    "triton",
    "onnxruntime",
    "onnxruntime-gpu",
    "numpy",
]

def load_toml(path: pathlib.Path):
    if not path.exists() or tomllib is None:
        return {}
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}

def get_nested(data, path, default):
    cur = data
    for part in path:
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return default
    return cur

base = load_toml(config_path) if config_path.exists() else load_toml(template_path)

final_comfyui = comfyui_override or str(get_nested(base, ("paths", "comfyui_dir"), "") or "").strip()
final_python = python_override or str(get_nested(base, ("runtime", "python"), "") or "").strip()

if not final_comfyui:
    raise SystemExit("ERROR: paths.comfyui_dir is required. Run 'gov init --comfyui-dir <abs-path> --python <python-spec>'.")
if not pathlib.Path(final_comfyui).is_absolute():
    raise SystemExit(f"ERROR: ComfyUI path must be absolute: {final_comfyui}")
if not final_python:
    raise SystemExit("ERROR: runtime.python is required. Run 'gov init --python <python-spec>'.")

runtime = {
    "python": final_python,
    "prod_env": str(get_nested(base, ("runtime", "prod_env"), ".venv-prod") or ".venv-prod"),
    "candidate_root": str(get_nested(base, ("runtime", "candidate_root"), ".venv-candidate") or ".venv-candidate"),
}
tx = {
    "timeout_seconds": int(get_nested(base, ("tx", "timeout_seconds"), 120) or 120),
    "smoke_test_cmd": str(get_nested(base, ("tx", "smoke_test_cmd"), "") or ""),
}
policy_packages = get_nested(base, ("policy", "core_packages"), DEFAULT_CORE_PACKAGES)
if not isinstance(policy_packages, list) or not policy_packages:
    policy_packages = DEFAULT_CORE_PACKAGES
policy = {
    "core_packages": [str(item) for item in policy_packages],
}
ops = {
    "retention_count": int(get_nested(base, ("ops", "retention_count"), 100) or 100),
}
run = {
    "extra_args": str(get_nested(base, ("run", "extra_args"), "") or ""),
    "sync_before_run": bool(get_nested(base, ("run", "sync_before_run"), False)),
}

sections = [
    ("paths", {"comfyui_dir": final_comfyui}),
    ("runtime", runtime),
    ("tx", tx),
    ("policy", policy),
    ("ops", ops),
    ("run", run),
]

def fmt_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        if not value:
            return "[]"
        parts = ",\n".join(f'    "{str(item)}"' for item in value)
        return "[\n" + parts + ",\n]"
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'

lines = ["# ComfyUI environment governance config (Batch-4)", ""]
for name, payload in sections:
    lines.append(f"[{name}]")
    for key, value in payload.items():
        rendered = fmt_value(value)
        lines.append(f"{key} = {rendered}")
    lines.append("")

config_path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

canonicalize_python_minor() {
    local request="${1:-}"
    if [ -z "$request" ]; then
        echo "ERROR: python request is required" >&2
        exit 1
    fi

    request="${request#"${request%%[![:space:]]*}"}"
    request="${request%"${request##*[![:space:]]}"}"
    if [ -z "$request" ]; then
        echo "ERROR: python request is required" >&2
        exit 1
    fi

    if [[ "$request" =~ ^([0-9]+)\.([0-9]+)(\.[0-9]+)?$ ]]; then
        echo "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
        return 0
    fi

    echo "$request"
}

resolve_python_minor() {
    local request canonical_request
    request="${1:-}"
    canonical_request="$(canonicalize_python_minor "$request")"

    if [[ "$request" =~ ^[[:space:]]*[0-9]+\.[0-9]+[[:space:]]*$ ]]; then
        echo "$canonical_request"
        return 0
    fi

    require_cmd uv
    local cache_dir
    cache_dir="$(uv_cache_dir)"
    mkdir -p "$cache_dir"

    local resolved
    if ! resolved="$(uv --cache-dir "$cache_dir" python find --no-python-downloads "$request")"; then
        echo "ERROR: failed to resolve python request: $request" >&2
        exit 1
    fi

    resolved="${resolved#"${resolved%%[![:space:]]*}"}"
    resolved="${resolved%"${resolved##*[![:space:]]}"}"
    if [ ! -x "$resolved" ]; then
        echo "ERROR: resolved python is not executable: $resolved" >&2
        exit 1
    fi

    local resolved_minor
    if ! resolved_minor="$("$resolved" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')"; then
        echo "ERROR: failed to inspect resolved python version: $resolved" >&2
        exit 1
    fi
    if ! [[ "$resolved_minor" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
        echo "ERROR: unsupported python version resolved from request: $resolved_minor" >&2
        exit 1
    fi
    echo "$resolved_minor"
}

current_uv_environment_marker() {
    require_python
    "${PYTHON_BIN}" - <<'PY'
import platform
import sys

print(f"sys_platform == '{sys.platform}' and platform_machine == '{platform.machine()}'")
PY
}

sync_project_runtime_constraints() {
    local project_file="$1"
    local python_minor="$2"
    local environment_marker="$3"

    require_python
    "${PYTHON_BIN}" - "$project_file" "$python_minor" "$environment_marker" <<'PY'
import pathlib
import re
import sys

project_path = pathlib.Path(sys.argv[1])
python_minor = sys.argv[2].strip()
environment_marker = sys.argv[3].strip()
requires_python = f"=={python_minor}.*"

if not project_path.exists():
    raise SystemExit(f"ERROR: project file not found: {project_path}")

lines = project_path.read_text(encoding="utf-8").splitlines()

def find_section(header: str):
    start = None
    for idx, line in enumerate(lines):
        if line.strip() == header:
            start = idx
            break
    if start is None:
        return None, None
    end = len(lines)
    for idx in range(start + 1, len(lines)):
        if re.match(r"^\[", lines[idx]):
            end = idx
            break
    return start, end

def value_block_end(start_idx: int) -> int:
    line = lines[start_idx]
    bracket_balance = line.count("[") - line.count("]")
    idx = start_idx + 1
    while bracket_balance > 0 and idx < len(lines):
        bracket_balance += lines[idx].count("[") - lines[idx].count("]")
        idx += 1
    return idx

def set_key(section_header: str, key: str, new_block_lines: list[str]):
    start, end = find_section(section_header)
    if start is None:
        raise SystemExit(f"ERROR: required TOML section missing: {section_header}")

    key_re = re.compile(rf"^\s*{re.escape(key)}\s*=")
    for idx in range(start + 1, end):
        if key_re.match(lines[idx]):
            block_end = value_block_end(idx)
            lines[idx:block_end] = new_block_lines
            return

    insert_at = end
    while insert_at > start + 1 and lines[insert_at - 1].strip() == "":
        insert_at -= 1
    lines[insert_at:insert_at] = new_block_lines

project_start, _ = find_section("[project]")
if project_start is None:
    raise SystemExit("ERROR: pyproject.toml is missing [project]")

tool_uv_start, tool_uv_end = find_section("[tool.uv]")
if tool_uv_start is None:
    insert_at = len(lines)
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[tool.uv.") or stripped.startswith("[[tool.uv."):
            insert_at = idx
            break
    block = []
    if insert_at > 0 and lines[insert_at - 1].strip() != "":
        block.append("")
    block.extend([
        "[tool.uv]",
        "environments = [",
        f"    \"{environment_marker}\",",
        "]",
    ])
    if insert_at < len(lines) and lines[insert_at].strip() != "":
        block.append("")
    lines[insert_at:insert_at] = block
else:
    set_key(
        "[tool.uv]",
        "environments",
        [
            "environments = [",
            f"    \"{environment_marker}\",",
            "]",
        ],
    )

set_key("[project]", "requires-python", [f'requires-python = "{requires_python}"'])

project_path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

ensure_state_dirs() {
    mkdir -p "${STATE_DIR}" "${TX_DIR}" "${LOG_DIR}" "${CONFLICT_DIR}" "${WORK_DIR}" "${CACHE_WHEELS_DIR}" "${OPS_DIR}" "${ROOT_DIR}/.venv-candidate"
}

ensure_plugins_registry() {
    if [ ! -f "${PLUGINS_FILE}" ]; then
        printf '[]\n' > "${PLUGINS_FILE}"
    fi
    migrate_plugins_registry
}

ensure_layout() {
    ensure_state_dirs
    ensure_plugins_registry
}

ensure_project_file_for_init() {
    if [ -f "$PROJECT_FILE" ]; then
        return 0
    fi
    if [ -f "$PROJECT_TEMPLATE_FILE" ]; then
        cp "$PROJECT_TEMPLATE_FILE" "$PROJECT_FILE"
        echo "Created local pyproject.toml from template."
        echo "  template: $PROJECT_TEMPLATE_FILE"
        return 0
    fi
    echo "ERROR: missing $PROJECT_FILE and template $PROJECT_TEMPLATE_FILE" >&2
    echo "Hint: restore pyproject.toml.template from repository, then rerun init." >&2
    exit 1
}

configured_python() {
    local value
    value="$(config_get "runtime.python" "")"
    if [ -z "$value" ]; then
        echo "ERROR: runtime.python is not configured. Run 'gov init --python <python-spec>'." >&2
        exit 1
    fi
    echo "$value"
}

lock_project_exact() {
    local project_dir="$1"
    local py="${2:-}"
    if [ -z "$py" ]; then
        py="$(configured_python)"
    fi
    (
        cd "$project_dir"
        uv lock --python "$py"
    )
}

sync_project_env_exact() {
    local project_dir="$1"
    local env_path="$2"
    local py="${3:-}"
    if [ -z "$py" ]; then
        py="$(configured_python)"
    fi
    (
        cd "$project_dir"
        UV_PROJECT_ENVIRONMENT="$env_path" uv sync --python "$py" --locked --exact --all-groups
    )
}

prod_env_path() {
    local rel
    rel="$(config_get "runtime.prod_env" ".venv-prod")"
    echo "${ROOT_DIR}/${rel}"
}

candidate_root_path() {
    local rel
    rel="$(config_get "runtime.candidate_root" ".venv-candidate")"
    echo "${ROOT_DIR}/${rel}"
}

comfyui_dir_path() {
    config_get "paths.comfyui_dir" "/opt/comfyui"
}

default_requirements_file() {
    local comfyui_dir
    comfyui_dir="$(comfyui_dir_path)"
    echo "${comfyui_dir}/requirements.txt"
}

tx_timeout_seconds() {
    config_get "tx.timeout_seconds" "120"
}

core_packages_csv() {
    config_get "policy.core_packages" "torch,torchvision,torchaudio,xformers,triton,onnxruntime,onnxruntime-gpu,numpy"
}

ops_retention_count() {
    local value
    value="$(config_get "ops.retention_count" "")"
    if [ -n "$value" ]; then
        echo "$value"
        return 0
    fi
    value="$(config_get "rollback.snapshot_retention" "")"
    if [ -n "$value" ]; then
        echo "$value"
        return 0
    fi
    echo "100"
}

smoke_test_cmd() {
    config_get "tx.smoke_test_cmd" ""
}

files_are_identical() {
    local left="$1"
    local right="$2"
    if [ ! -f "$left" ] || [ ! -f "$right" ]; then
        return 1
    fi
    cmp -s "$left" "$right"
}

normalize_group_name() {
    local raw="${1:-}"
    local out
    out="$(echo "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[-_.]+/-/g; s/^-+//; s/-+$//')"
    echo "$out"
}

group_name_for_node() {
    local node_id="$1"
    local norm
    norm="$(normalize_group_name "$node_id")"
    if [ -z "$norm" ]; then
        norm="$node_id"
    fi
    echo "node-${norm}"
}

_random_hex8() {
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen | tr -d '-' | head -c 8 | tr '[:upper:]' '[:lower:]'
    elif [ -r /proc/sys/kernel/random/uuid ]; then
        tr -d '-' < /proc/sys/kernel/random/uuid | head -c 8
    else
        od -An -tx1 -N4 /dev/urandom | tr -d ' \n' | head -c 8
    fi
}

new_txid() {
    echo "$(date -u +"%Y%m%dT%H%M%SZ")-$(_random_hex8)"
}

new_op_id() {
    echo "$(date -u +"%Y%m%dT%H%M%SZ")-op-$(_random_hex8)"
}

file_sha256() {
    local file_path="$1"
    if [ ! -f "$file_path" ]; then
        echo ""
        return 0
    fi
    sha256sum "$file_path" | cut -d' ' -f1
}

backup_file_with_marker() {
    local src="$1"
    local backup="$2"
    local marker="$3"
    if [ -e "$src" ]; then
        cp -a "$src" "$backup"
        printf '1\n' > "$marker"
    else
        : > "$backup"
        printf '0\n' > "$marker"
    fi
}

restore_file_with_marker() {
    local backup="$1"
    local dst="$2"
    local marker="$3"
    local existed="0"
    if [ -f "$marker" ]; then
        existed="$(tr -d '\n' < "$marker")"
    fi
    if [ "$existed" = "1" ]; then
        cp -a "$backup" "$dst"
    else
        rm -f "$dst"
    fi
}

run_smoke_test_in_env() {
    local env_path="$1"
    local comfyui_dir="$2"
    local smoke_cmd
    smoke_cmd="$(smoke_test_cmd)"
    if [ -n "$smoke_cmd" ]; then
        (cd "$comfyui_dir" && PATH="$env_path/bin:$PATH" bash -lc "$smoke_cmd")
    else
        "$env_path/bin/python" -c "import sys; print(sys.version)" >/dev/null 2>&1
    fi
}

dep_name_from_spec() {
    local spec="$1"
    require_python
    "${PYTHON_BIN}" - "$spec" <<'PY'
import re
import sys

spec = sys.argv[1].strip()
if not spec:
    print("")
    raise SystemExit(0)

token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
if "@" in token:
    token = token.split("@", 1)[0].strip()

print(token)
PY
}

normalize_dep_name() {
    local raw="${1:-}"
    local name
    name="$(dep_name_from_spec "$raw")"
    normalize_group_name "$name"
}

pin_name_is_recommended() {
    local dep_name="$1"
    case "$dep_name" in
        numpy|transformers)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

torch_family_dep_name_is_managed() {
    local dep_name="$1"
    case "$dep_name" in
        torch|torchvision|torchaudio)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

warn_for_unrecommended_pin_specs() {
    local spec dep_name
    for spec in "$@"; do
        dep_name="$(normalize_dep_name "$spec")"
        if [ -n "$dep_name" ] && ! pin_name_is_recommended "$dep_name"; then
            echo "WARNING: pinning non-recommended package: $spec" >&2
        fi
    done
}

write_pin_specs_last_wins() {
    local out_file="$1"
    shift
    require_python
    "${PYTHON_BIN}" - "$out_file" "$@" <<'PY'
import pathlib
import re
import sys

out_file = pathlib.Path(sys.argv[1])
items = [str(x).strip() for x in sys.argv[2:] if str(x).strip()]

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec.strip(), maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower().strip("-")

last_seen: dict[str, tuple[int, str]] = {}
for idx, item in enumerate(items):
    norm = normalize_name(item)
    if not norm:
        continue
    last_seen[norm] = (idx, item)

ordered = [item for _, item in sorted(last_seen.values(), key=lambda entry: entry[0])]
out_file.write_text("\n".join(ordered) + ("\n" if ordered else ""), encoding="utf-8")
PY
}

write_group_names_matching_specs() {
    local pyproject_file="$1"
    local group_name="$2"
    local out_file="$3"
    shift 3
    require_python
    "${PYTHON_BIN}" - "$pyproject_file" "$group_name" "$out_file" "$@" <<'PY'
import pathlib
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

pyproject = pathlib.Path(sys.argv[1])
group = sys.argv[2]
out_file = pathlib.Path(sys.argv[3])
items = [str(x).strip() for x in sys.argv[4:] if str(x).strip()]

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec.strip(), maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower().strip("-")

existing: set[str] = set()
if pyproject.exists():
    text = pyproject.read_text(encoding="utf-8")
    try:
        data = tomllib.loads(text)
    except Exception as exc:
        raise SystemExit(f"ERROR: failed to parse pyproject.toml: {exc}")
    groups = data.get("dependency-groups", {})
    raw = groups.get(group, []) if isinstance(groups, dict) else []
    if isinstance(raw, list):
        for item in raw:
            if not isinstance(item, str):
                continue
            spec = item.strip()
            if not spec:
                continue
            norm = normalize_name(spec)
            if norm:
                existing.add(norm)

matched: list[str] = []
seen: set[str] = set()
for item in items:
    norm = normalize_name(item)
    if not norm or norm in seen:
        continue
    seen.add(norm)
    if norm in existing:
        matched.append(norm)

out_file.write_text("\n".join(matched) + ("\n" if matched else ""), encoding="utf-8")
PY
}

rewrite_dependency_group() {
    local pyproject_file="$1"
    local group="$2"
    local mode="$3"
    shift 3

    require_python
    "${PYTHON_BIN}" - "$pyproject_file" "$group" "$mode" "$@" <<'PY'
import json
import pathlib
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

path = pathlib.Path(sys.argv[1])
group = sys.argv[2]
mode = sys.argv[3]
items = [str(x).strip() for x in sys.argv[4:] if str(x).strip()]

if not path.exists():
    raise SystemExit(f"ERROR: project file not found: {path}")

text = path.read_text(encoding="utf-8")
try:
    data = tomllib.loads(text)
except Exception as exc:
    raise SystemExit(f"ERROR: failed to parse pyproject.toml: {exc}")

groups = data.get("dependency-groups", {})
if not isinstance(groups, dict):
    groups = {}

entries = groups.get(group, [])
if not isinstance(entries, list):
    entries = []

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec.strip(), maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower().strip("-")

def entry_name(entry) -> str:
    if not isinstance(entry, str):
        return ""
    spec = entry.strip()
    if not spec:
        return ""
    return normalize_name(spec)

def dedupe_exact_specs(values: list[str]) -> list[str]:
    ordered: list[str] = []
    seen: set[str] = set()
    for value in values:
        norm = normalize_name(value)
        if not norm or norm in seen:
            continue
        seen.add(norm)
        ordered.append(value)
    return ordered

if mode == "upsert_exact":
    requested_order: list[str] = []
    requested_specs: dict[str, str] = {}
    emitted: set[str] = set()
    out: list[str] = []

    for item in items:
        norm = normalize_name(item)
        if not norm:
            continue
        if norm not in requested_specs:
            requested_order.append(norm)
        requested_specs[norm] = item

    for entry in entries:
        norm = entry_name(entry)
        if norm in requested_specs:
            if norm not in emitted:
                out.append(requested_specs[norm])
                emitted.add(norm)
            continue
        out.append(entry)

    for norm in requested_order:
        if norm not in emitted:
            out.append(requested_specs[norm])
            emitted.add(norm)

    groups[group] = out
elif mode == "remove_names":
    requested_order: list[str] = []
    remove_set: set[str] = set()
    found: set[str] = set()
    out: list[str] = []

    for item in items:
        norm = normalize_name(item)
        if not norm:
            continue
        if norm not in remove_set:
            requested_order.append(norm)
        remove_set.add(norm)

    for entry in entries:
        norm = entry_name(entry)
        if norm in remove_set:
            found.add(norm)
            continue
        out.append(entry)

    missing = [norm for norm in requested_order if norm not in found]
    if missing:
        print(f"ERROR: pin not found for package(s): {' '.join(missing)}", file=sys.stderr)
        raise SystemExit(1)

    groups[group] = out
elif mode == "replace_exact":
    groups[group] = dedupe_exact_specs(items)
else:
    raise SystemExit(f"ERROR: unsupported dependency-group rewrite mode: {mode}")

def render_toml_key(value: str) -> str:
    if re.match(r"^[A-Za-z0-9_-]+$", value):
        return value
    return json.dumps(value)

def render_toml_literal_key(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"

def serialized_toml_keys(value: str) -> list[str]:
    candidates = []
    if re.match(r"^[A-Za-z0-9_-]+$", value):
        candidates.append(value)
    candidates.append(json.dumps(value))
    candidates.append(render_toml_literal_key(value))
    out: list[str] = []
    seen: set[str] = set()
    for item in candidates:
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    return out

def render_toml_value(value):
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, list):
        return "[" + ", ".join(render_toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        parts = [f"{render_toml_key(str(key))} = {render_toml_value(item)}" for key, item in value.items()]
        return "{ " + ", ".join(parts) + " }"
    raise SystemExit(f"ERROR: unsupported dependency-group item type: {type(value).__name__}")

def render_group_assignment(rendered_key: str, values) -> str:
    if not isinstance(values, list):
        values = []
    if not values:
        return f"{rendered_key} = []\n"
    rendered = ",\n".join(f"    {render_toml_value(value)}" for value in values)
    return f"{rendered_key} = [\n{rendered},\n]\n"

def bracket_balance(text: str) -> int:
    balance = 0
    in_string = False
    escape = False
    for ch in text:
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            continue
        if ch == '"':
            in_string = True
        elif ch == "[":
            balance += 1
        elif ch == "]":
            balance -= 1
    return balance

def replace_group_assignment(section_text: str, group_name: str, values) -> str:
    lines = section_text.splitlines(keepends=True)
    key_choices = serialized_toml_keys(group_name)
    key_re = re.compile(rf"^({'|'.join(re.escape(key) for key in key_choices)})\s*=")

    for idx in range(1, len(lines)):
        match = key_re.match(lines[idx].strip())
        if not match:
            continue
        assignment = render_group_assignment(match.group(1), values)
        balance = 0
        found_array = False
        end = idx
        while end < len(lines):
            chunk = lines[end]
            if "=" in chunk or found_array:
                rhs = chunk.split("=", 1)[1] if not found_array and "=" in chunk else chunk
                if "[" in rhs or found_array:
                    found_array = True
                    balance += bracket_balance(rhs)
                    if balance <= 0:
                        break
            end += 1
        return "".join(lines[:idx]) + assignment + "".join(lines[end + 1:])

    if not section_text.endswith("\n"):
        section_text += "\n"
    return section_text + render_group_assignment(render_toml_key(group_name), values)

section_re = re.compile(r"(?ms)^\[dependency-groups\]\n.*?(?=^\[|\Z)")
match = section_re.search(text)
if match:
    new_section = replace_group_assignment(match.group(0), group, groups.get(group, []))
    text = text[:match.start()] + new_section + text[match.end():]
else:
    if text and not text.endswith("\n"):
        text += "\n"
    text += "\n[dependency-groups]\n" + render_group_assignment(render_toml_key(group), groups.get(group, []))

path.write_text(text, encoding="utf-8")
PY
}

torch_index_name_from_url() {
    local index_url="$1"
    require_python
    "${PYTHON_BIN}" - "$index_url" <<'PY'
import pathlib
import re
import sys
from urllib.parse import urlparse

url = sys.argv[1].strip()
parsed = urlparse(url)
segments = [seg for seg in parsed.path.split("/") if seg]
tail = segments[-1] if segments else ""
tail = re.sub(r"[-_.]+", "-", tail.lower()).strip("-")

if tail:
    print(f"pytorch-{tail}")
else:
    print("pytorch-custom")
PY
}

read_requirements_file_exact() {
    local requirements_file="$1"
    local out_file="$2"
    require_python
    "${PYTHON_BIN}" - "$requirements_file" "$out_file" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
out = pathlib.Path(sys.argv[2])

if not path.exists():
    print(f"ERROR: requirements file not found: {path}", file=sys.stderr)
    raise SystemExit(1)

deps = []
filtered = []

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

for idx, raw in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith(("-r", "-c")) or line.startswith("--"):
        print(f"ERROR: unsupported requirements directive at line {idx}: {line}", file=sys.stderr)
        raise SystemExit(2)
    name = normalize_name(line)
    if name in {"torch", "torchvision", "torchaudio"}:
        filtered.append(line)
        continue
    deps.append(line)

out.write_text("\n".join(deps) + ("\n" if deps else ""), encoding="utf-8")
if filtered:
    print("Filtered torch-family requirements: " + ", ".join(filtered), file=sys.stderr)
PY
}

torch_group_ready() {
    require_python
    "${PYTHON_BIN}" - "$PROJECT_FILE" <<'PY'
import pathlib
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

path = pathlib.Path(sys.argv[1])
if not path.exists():
    raise SystemExit(1)

try:
    data = tomllib.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(2)

groups = data.get("dependency-groups", {})
raw = groups.get("torch", []) if isinstance(groups, dict) else []
if not isinstance(raw, list):
    raw = []

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

found = {normalize_name(str(item)) for item in raw if str(item).strip()}
required = {"torch", "torchvision", "torchaudio"}
raise SystemExit(0 if required.issubset(found) else 3)
PY
}

set_dependency_group_exact() {
    local project_dir="$1"
    local group_name="$2"
    local desired_file="$3"
    local current_file dep spec dep_name py

    current_file="$(mktemp)"
    py="$(configured_python)"
    write_group_deps "$project_dir/pyproject.toml" "$group_name" "$current_file"

    if [ -s "$current_file" ]; then
        while IFS= read -r dep; do
            [ -z "$dep" ] && continue
            dep_name="$(dep_name_from_spec "$dep")"
            [ -z "$dep_name" ] && continue
            (
                cd "$project_dir"
                uv remove --group "$group_name" --python "$py" --no-sync "$dep_name"
            )
        done < "$current_file"
    fi

    if [ -s "$desired_file" ]; then
        while IFS= read -r spec; do
            [ -z "$spec" ] && continue
            (
                cd "$project_dir"
                uv add --group "$group_name" --python "$py" --no-sync "$spec"
            )
        done < "$desired_file"
    fi

    rm -f "$current_file"
}

append_pins_to_overrides_group() {
    local project_dir="$1"
    local pins_file="$2"
    local py pin

    py="$(configured_python)"
    if [ ! -s "$pins_file" ]; then
        return 0
    fi

    while IFS= read -r pin; do
        [ -z "$pin" ] && continue
        (
            cd "$project_dir"
            uv add --group overrides --python "$py" --no-sync "$pin"
        )
    done < "$pins_file"
}

ops_prune() {
    ensure_layout
    local retention
    retention="$(ops_retention_count)"
    require_python
    "${PYTHON_BIN}" - "$OPS_DIR" "$retention" <<'PY'
import pathlib
import shutil
import sys

root = pathlib.Path(sys.argv[1])
try:
    retention = int(sys.argv[2])
except Exception:
    retention = 100
if retention < 1:
    retention = 1

ops = sorted([p for p in root.iterdir() if p.is_dir()], key=lambda p: p.name)
if len(ops) <= retention:
    raise SystemExit(0)

for p in ops[:-retention]:
    shutil.rmtree(p, ignore_errors=True)
PY
}

op_begin() {
    local kind="$1"
    local ref="$2"
    ensure_state_dirs
    require_python

    local op_id op_dir backup_dir
    op_id="$(new_op_id)"
    op_dir="${OPS_DIR}/${op_id}"
    backup_dir="${op_dir}/backup"
    mkdir -p "$backup_dir"

    backup_file_with_marker "$PROJECT_FILE" "${backup_dir}/pyproject.toml" "${backup_dir}/pyproject.toml.present"
    backup_file_with_marker "$LOCK_FILE" "${backup_dir}/uv.lock" "${backup_dir}/uv.lock.present"
    backup_file_with_marker "$PLUGINS_FILE" "${backup_dir}/plugins.json" "${backup_dir}/plugins.json.present"

    "${PYTHON_BIN}" - "$op_dir/meta.json" "$op_id" "$kind" "$ref" "$(timestamp_utc)" "$backup_dir" \
        "$(file_sha256 "$PROJECT_FILE")" "$(file_sha256 "$LOCK_FILE")" "$(file_sha256 "$PLUGINS_FILE")" <<'PY'
import json
import pathlib
import sys

meta_path = pathlib.Path(sys.argv[1])
meta = {
    "op_id": sys.argv[2],
    "kind": sys.argv[3],
    "ref": sys.argv[4],
    "status": "running",
    "started_at": sys.argv[5],
    "ended_at": "",
    "files": {
        "pyproject.toml": {"pre_sha256": sys.argv[7], "post_sha256": ""},
        "uv.lock": {"pre_sha256": sys.argv[8], "post_sha256": ""},
        "plugins.json": {"pre_sha256": sys.argv[9], "post_sha256": ""},
    },
    "backup_dir": sys.argv[6],
    "undoable": False,
    "note": "",
}
meta_path.write_text(json.dumps(meta, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY

    echo "$op_id"
}

op_restore_backup() {
    local op_id="$1"
    local op_dir="${OPS_DIR}/${op_id}"
    local backup_dir="${op_dir}/backup"
    if [ ! -d "$backup_dir" ]; then
        echo "ERROR: op backup missing: $op_id" >&2
        return 1
    fi
    restore_file_with_marker "${backup_dir}/pyproject.toml" "$PROJECT_FILE" "${backup_dir}/pyproject.toml.present"
    restore_file_with_marker "${backup_dir}/uv.lock" "$LOCK_FILE" "${backup_dir}/uv.lock.present"
    restore_file_with_marker "${backup_dir}/plugins.json" "$PLUGINS_FILE" "${backup_dir}/plugins.json.present"
}

op_finalize() {
    local op_id="$1"
    local status="$2"
    local undoable="$3"
    local note="$4"
    local op_dir="${OPS_DIR}/${op_id}"
    require_python
    "${PYTHON_BIN}" - "$op_dir/meta.json" "$status" "$undoable" "$note" "$(timestamp_utc)" \
        "$(file_sha256 "$PROJECT_FILE")" "$(file_sha256 "$LOCK_FILE")" "$(file_sha256 "$PLUGINS_FILE")" <<'PY'
import json
import pathlib
import sys

meta_path = pathlib.Path(sys.argv[1])
status = sys.argv[2]
undoable = sys.argv[3].lower() == "true"
note = sys.argv[4]
ended_at = sys.argv[5]
post_pyproject = sys.argv[6]
post_lock = sys.argv[7]
post_plugins = sys.argv[8]

data = json.loads(meta_path.read_text(encoding="utf-8"))
data["status"] = status
data["ended_at"] = ended_at
data["undoable"] = undoable
data["note"] = note
files = data.get("files", {})
files.setdefault("pyproject.toml", {})["post_sha256"] = post_pyproject
files.setdefault("uv.lock", {})["post_sha256"] = post_lock
files.setdefault("plugins.json", {})["post_sha256"] = post_plugins
data["files"] = files
meta_path.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

