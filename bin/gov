        cd "$ROOT_DIR"
        uv export --format pylock.toml --locked --all-groups --output-file "$pylock_file"
    )
}

bundle_copy_custom_nodes() {
    local bundle_dir="$1"
    local comfyui_dir="$2"
    local plugins_file="${3:-$PLUGINS_FILE}"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$comfyui_dir" "$plugins_file" <<'PY'
import json
import pathlib
import shutil
import sys

bundle_dir = pathlib.Path(sys.argv[1])
comfyui_dir = pathlib.Path(sys.argv[2]).resolve()
plugins_path = pathlib.Path(sys.argv[3])
custom_nodes_root = bundle_dir / "custom_nodes"
custom_nodes_root.mkdir(parents=True, exist_ok=True)

try:
    data = json.loads(plugins_path.read_text(encoding="utf-8")) if plugins_path.exists() else []
except Exception as exc:
    raise SystemExit(f"ERROR: failed to read plugins registry: {exc}")

if not isinstance(data, list):
    raise SystemExit("ERROR: plugins registry must be a JSON array")

def resolve_under(base: pathlib.Path, rel: str, label: str) -> pathlib.Path:
    rel_path = pathlib.Path(rel)
    if rel_path.is_absolute():
        raise SystemExit(f"ERROR: {label} must be relative: {rel}")
    target = (base / rel_path).resolve()
    try:
        target.relative_to(base)
    except Exception:
        raise SystemExit(f"ERROR: {label} escapes base directory: {rel}")
    return target

def ignore_vcs_admin(_dir: str, names):
    # Export the runtime snapshot, not repository admin state.
    return {name for name in names if name == ".git"}

for item in data:
    if not isinstance(item, dict):
        continue
    node_id = str(item.get("id") or "").strip()
    if not node_id:
        raise SystemExit("ERROR: plugins registry contains item without id")
    rel = str(item.get("install_relpath") or f"custom_nodes/{node_id}").strip()
    source_dir = resolve_under(comfyui_dir, rel, f"install_relpath for node '{node_id}'")
    if not source_dir.exists() or not source_dir.is_dir():
        raise SystemExit(f"ERROR: plugin source directory missing for node '{node_id}': {source_dir}")
    dest_dir = custom_nodes_root / node_id
    if dest_dir.exists():
        shutil.rmtree(dest_dir)
    shutil.copytree(source_dir, dest_dir, ignore=ignore_vcs_admin)
PY
}

bundle_write_export_summary() {
    local bundle_dir="$1"
    local created_at="$2"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$created_at" "$(configured_python)" <<'PY'
import json
import pathlib
import sys

bundle_dir = pathlib.Path(sys.argv[1])
created_at = sys.argv[2]
python_spec = sys.argv[3]
plugins_path = bundle_dir / "state" / "plugins.json"
project_path = bundle_dir / "pyproject.toml"

try:
    plugins = json.loads(plugins_path.read_text(encoding="utf-8")) if plugins_path.exists() else []
except Exception:
    plugins = []

node_ids = []
for item in plugins:
    if isinstance(item, dict) and str(item.get("id") or "").strip():
        node_ids.append(str(item["id"]).strip())

summary = {
    "created_at": created_at,
    "python_spec": python_spec,
    "node_ids": sorted(node_ids),
    "node_count": len(node_ids),
    "has_pyproject": project_path.exists(),
    "has_uv_lock": (bundle_dir / "uv.lock").exists(),
    "has_pylock": (bundle_dir / "pylock.toml").exists(),
}

out_path = bundle_dir / "audit" / "export-summary.json"
out_path.parent.mkdir(parents=True, exist_ok=True)
out_path.write_text(json.dumps(summary, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

bundle_manifest_write() {
    local bundle_dir="$1"
    local created_at="$2"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$created_at" "$(configured_python)" <<'PY'
import getpass
import hashlib
import json
import pathlib
import platform
import socket
import sys

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
created_at = sys.argv[2]
python_spec = sys.argv[3]
manifest_path = bundle_dir / "manifest.json"
plugins_path = bundle_dir / "state" / "plugins.json"

try:
    plugins = json.loads(plugins_path.read_text(encoding="utf-8")) if plugins_path.exists() else []
except Exception:
    plugins = []

node_ids = []
for item in plugins:
    if isinstance(item, dict) and str(item.get("id") or "").strip():
        node_ids.append(str(item["id"]).strip())

files = {}
for path in sorted(p for p in bundle_dir.rglob("*") if p.is_file() and p != manifest_path):
    rel = str(path.relative_to(bundle_dir)).replace("\\", "/")
    files[rel] = hashlib.sha256(path.read_bytes()).hexdigest()

payload = {
    "bundle_format_version": "1",
    "created_at": created_at,
    "created_by": f"{getpass.getuser()}@{socket.gethostname()}",
    "python_spec": python_spec,
    "python_version": platform.python_version(),
    "platform_system": platform.system(),
    "platform_machine": platform.machine(),
    "node_ids": sorted(node_ids),
    "files": {
        "sha256": files,
    },
}

manifest_path.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

bundle_manifest_verify() {
    local bundle_dir="$1"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
manifest_path = bundle_dir / "manifest.json"
if not bundle_dir.exists() or not bundle_dir.is_dir():
    raise SystemExit(f"ERROR: bundle directory not found: {bundle_dir}")
if not manifest_path.exists():
    raise SystemExit(f"ERROR: bundle manifest missing: {manifest_path}")

manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
required_top = [
    "bundle_format_version",
    "created_at",
    "created_by",
    "python_spec",
    "python_version",
    "platform_system",
    "platform_machine",
    "node_ids",
    "files",
]
for key in required_top:
    if key not in manifest:
        raise SystemExit(f"ERROR: manifest missing field: {key}")

sha_map = (manifest.get("files") or {}).get("sha256")
if not isinstance(sha_map, dict):
    raise SystemExit("ERROR: manifest files.sha256 must be a mapping")

required_files = [
    "pyproject.toml",
    "uv.lock",
    "pylock.toml",
    "state/plugins.json",
    "audit/prod-freeze.txt",
    "audit/export-summary.json",
]
for rel in required_files:
    if rel not in sha_map:
        raise SystemExit(f"ERROR: manifest missing checksum entry for {rel}")

for rel, expected in sha_map.items():
    path = bundle_dir / rel
    if not path.exists() or not path.is_file():
        raise SystemExit(f"ERROR: bundle file missing: {rel}")
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit(f"ERROR: bundle checksum mismatch: {rel}")
PY
}

bundle_check_import_conflicts() {
    local bundle_dir="$1"
    local comfyui_dir="$2"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$comfyui_dir" <<'PY'
import json
import pathlib
import sys

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
raw_comfyui_dir = pathlib.Path(sys.argv[2])
if not raw_comfyui_dir.is_absolute():
    raise SystemExit(f"ERROR: ComfyUI path must be absolute: {raw_comfyui_dir}")
comfyui_dir = raw_comfyui_dir.resolve()
bundle_plugins = bundle_dir / "state" / "plugins.json"

if not comfyui_dir.exists() or not comfyui_dir.is_dir():
    raise SystemExit(f"ERROR: ComfyUI directory not found: {comfyui_dir}")

try:
    data = json.loads(bundle_plugins.read_text(encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"ERROR: failed to read bundle plugins registry: {exc}")

if not isinstance(data, list):
    raise SystemExit("ERROR: bundle plugins registry must be a JSON array")

def resolve_under(base: pathlib.Path, rel: str, label: str) -> pathlib.Path:
    rel_path = pathlib.Path(rel)
    if rel_path.is_absolute():
        raise SystemExit(f"ERROR: {label} must be relative: {rel}")
    target = (base / rel_path).resolve()
    try:
        target.relative_to(base)
    except Exception:
        raise SystemExit(f"ERROR: {label} escapes base directory: {rel}")
    return target

for item in data:
    if not isinstance(item, dict):
        continue
    node_id = str(item.get("id") or "").strip()
    if not node_id:
        raise SystemExit("ERROR: bundle plugins registry contains item without id")
    rel = str(item.get("install_relpath") or f"custom_nodes/{node_id}").strip()
    resolve_under(comfyui_dir, rel, f"install_relpath for node '{node_id}'")
PY
}

bundle_stage_truth() {
    local bundle_dir="$1"
    local workdir="$2"
    mkdir -p "$workdir/state"
    cp "${bundle_dir}/pyproject.toml" "${workdir}/pyproject.toml"
    cp "${bundle_dir}/uv.lock" "${workdir}/uv.lock"
    cp "${bundle_dir}/state/plugins.json" "${workdir}/state/plugins.json"
}

bundle_lock_check() {
    local workdir="$1"
    local py="$2"
    (
        cd "$workdir"
        uv lock --check --python "$py"
    )
}

bundle_check_runtime_compatibility() {
    local bundle_dir="$1"
    local target_python="$2"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$target_python" <<'PY'
import ast
import json
import os
import pathlib
import platform
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
target_python = sys.argv[2].strip()
bundle_project = bundle_dir / "pyproject.toml"
manifest_path = bundle_dir / "manifest.json"

match = re.fullmatch(r"(\d+)\.(\d+)", target_python)
if not match:
    raise SystemExit(f"ERROR: target python must be a canonical minor version, got: {target_python}")

target_minor = (match.group(1), match.group(2))
target_requires = f"=={target_minor[0]}.{target_minor[1]}.*"

def implementation_version() -> str:
    version = sys.implementation.version
    value = f"{version.major}.{version.minor}.{version.micro}"
    if version.releaselevel != "final":
        suffix = {
            "alpha": "a",
            "beta": "b",
            "candidate": "rc",
        }.get(version.releaselevel, version.releaselevel)
        value += f"{suffix}{version.serial}"
    return value

def current_marker_environment() -> dict[str, str]:
    python_full_version = platform.python_version()
    return {
        "extra": "",
        "implementation_name": sys.implementation.name,
        "implementation_version": implementation_version(),
        "os_name": os.name,
        "platform_machine": platform.machine(),
        "platform_python_implementation": platform.python_implementation(),
        "platform_release": platform.release(),
        "platform_system": platform.system(),
        "platform_version": platform.version(),
        "python_full_version": python_full_version,
        "python_version": ".".join(python_full_version.split(".")[:2]),
        "sys_platform": sys.platform,
    }

MARKER_ENV = current_marker_environment()
VERSION_FIELDS = {"implementation_version", "python_full_version", "python_version"}

def exact_minor_tuple(value: str):
    exact_minor = re.fullmatch(r"==\s*(\d+)\.(\d+)\.\*", value)
    if not exact_minor:
        return None
    return exact_minor.group(1), exact_minor.group(2)

def normalized_version_parts(value: str):
    parts = []
    for token in re.split(r"[._-]", str(value).strip()):
        if not token:
            continue
        parts.append(int(token) if token.isdigit() else token.lower())
    return tuple(parts)

def compare_marker_values(left, right, op, left_name: str | None, right_name: str | None) -> bool:
    if isinstance(op, ast.In):
        return str(left) in str(right)
    if isinstance(op, ast.NotIn):
        return str(left) not in str(right)

    if left_name in VERSION_FIELDS or right_name in VERSION_FIELDS:
        left_value = normalized_version_parts(left)
        right_value = normalized_version_parts(right)
    else:
        left_value = str(left)
        right_value = str(right)

    if isinstance(op, ast.Eq):
        return left_value == right_value
    if isinstance(op, ast.NotEq):
        return left_value != right_value
    if isinstance(op, ast.Lt):
        return left_value < right_value
    if isinstance(op, ast.LtE):
        return left_value <= right_value
    if isinstance(op, ast.Gt):
        return left_value > right_value
    if isinstance(op, ast.GtE):
        return left_value >= right_value
    raise ValueError(f"unsupported marker operator: {ast.dump(op)}")

def marker_name(node) -> str | None:
    if isinstance(node, ast.Name):
        return node.id
    return None

def marker_value(node):
    if isinstance(node, ast.Name):
        if node.id not in MARKER_ENV:
            raise ValueError(f"unsupported marker variable: {node.id}")
        return MARKER_ENV[node.id]
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    raise ValueError(f"unsupported marker expression: {ast.dump(node)}")

def eval_marker_ast(node) -> bool:
    if isinstance(node, ast.Expression):
        return eval_marker_ast(node.body)
    if isinstance(node, ast.BoolOp):
        values = [eval_marker_ast(value) for value in node.values]
        if isinstance(node.op, ast.And):
            return all(values)
        if isinstance(node.op, ast.Or):
            return any(values)
        raise ValueError(f"unsupported boolean operator: {ast.dump(node.op)}")
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
        return not eval_marker_ast(node.operand)
    if isinstance(node, ast.Compare):
        left_node = node.left
        left_value = marker_value(left_node)
        left_name = marker_name(left_node)
        for op, comparator in zip(node.ops, node.comparators):
            right_value = marker_value(comparator)
            right_name = marker_name(comparator)
            if not compare_marker_values(left_value, right_value, op, left_name, right_name):
                return False
            left_value = right_value
            left_name = right_name
        return True
    raise ValueError(f"unsupported marker syntax: {ast.dump(node)}")

def marker_matches_environment(marker: str) -> bool:
    marker = marker.strip()
    if not marker:
        return False

    try:
        from packaging.markers import Marker
    except ModuleNotFoundError:
        Marker = None

    if Marker is not None:
        try:
            return bool(Marker(marker).evaluate(environment=MARKER_ENV))
        except Exception:
            pass

    parsed = ast.parse(marker, mode="eval")
    return eval_marker_ast(parsed)

project = {}
if bundle_project.exists():
    project = tomllib.loads(bundle_project.read_text(encoding="utf-8"))

requires_python = str((project.get("project") or {}).get("requires-python") or "").strip()
bundle_minor = exact_minor_tuple(requires_python)
if bundle_minor and bundle_minor != target_minor:
    raise SystemExit(
        f"ERROR: bundle requires-python is {requires_python}, but target python resolves to {target_requires}"
    )

tool_uv = (project.get("tool") or {}).get("uv") or {}
environments = tool_uv.get("environments") or []
if isinstance(environments, str):
    environments = [environments]
normalized_envs = [str(item).strip() for item in environments if str(item).strip()]
if normalized_envs:
    if not any(marker_matches_environment(marker) for marker in normalized_envs):
        raise SystemExit(
            "ERROR: bundle environments do not support this host: "
            f"markers={normalized_envs}, host={MARKER_ENV['sys_platform']}/{MARKER_ENV['platform_machine']}"
        )
elif manifest_path.exists():
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    manifest_system = str(manifest.get("platform_system") or "").strip()
    manifest_machine = str(manifest.get("platform_machine") or "").strip()
    current_system = platform.system()
    current_machine = platform.machine()
    if manifest_system and manifest_machine and (
        manifest_system != current_system or manifest_machine != current_machine
    ):
        raise SystemExit(
            "ERROR: bundle platform does not match this host: "
            f"bundle={manifest_system}/{manifest_machine}, host={current_system}/{current_machine}"
        )
PY
}

bundle_restore_plugins_registry() {
    local bundle_dir="$1"
    cp "${bundle_dir}/state/plugins.json" "$PLUGINS_FILE"
}

bundle_backup_custom_nodes() {
    local bundle_dir="$1"
    local op_id="$2"
    local comfyui_dir="$3"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "${OPS_DIR}/${op_id}/backup" "$comfyui_dir" <<'PY'
import json
import pathlib
import shutil
import sys

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
backup_dir = pathlib.Path(sys.argv[2]).resolve()
comfyui_dir = pathlib.Path(sys.argv[3]).resolve()
plugins_path = bundle_dir / "state" / "plugins.json"
backup_root = backup_dir / "custom_nodes"
manifest_path = backup_dir / "custom_nodes_manifest.json"
custom_nodes_root = comfyui_dir / "custom_nodes"
backup_root.mkdir(parents=True, exist_ok=True)

try:
    data = json.loads(plugins_path.read_text(encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"ERROR: failed to read bundle plugins registry: {exc}")

if not isinstance(data, list):
    raise SystemExit("ERROR: bundle plugins registry must be a JSON array")

def resolve_under(base: pathlib.Path, rel: str, label: str) -> pathlib.Path:
    rel_path = pathlib.Path(rel)
    if rel_path.is_absolute():
        raise SystemExit(f"ERROR: {label} must be relative: {rel}")
    target = (base / rel_path).resolve()
    try:
        target.relative_to(base)
    except Exception:
        raise SystemExit(f"ERROR: {label} escapes base directory: {rel}")
    return target

if custom_nodes_root.exists() and not custom_nodes_root.is_dir():
    raise SystemExit(f"ERROR: target custom_nodes root is not a directory: {custom_nodes_root}")

records = []
expected_custom_node_dirs = set()
for item in data:
    if not isinstance(item, dict):
        continue
    node_id = str(item.get("id") or "").strip()
    if not node_id:
        raise SystemExit("ERROR: bundle plugins registry contains item without id")
    rel = str(item.get("install_relpath") or f"custom_nodes/{node_id}").strip()
    rel_path = pathlib.Path(rel)
    if len(rel_path.parts) >= 2 and rel_path.parts[0] == "custom_nodes":
        expected_custom_node_dirs.add(rel_path.parts[1])
    target = resolve_under(comfyui_dir, rel, f"install_relpath for node '{node_id}'")
    existed = target.exists()
    if existed and not target.is_dir():
        raise SystemExit(f"ERROR: target path is not a directory for node '{node_id}': {target}")
    backup_name = ""
    if existed:
        backup_name = f"entry-{len(records):04d}"
        dest = backup_root / backup_name
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(target, dest)
    records.append({
        "node_id": node_id,
        "install_relpath": rel,
        "existed": existed,
        "backup_name": backup_name,
    })

if custom_nodes_root.exists():
    for child in sorted(custom_nodes_root.iterdir(), key=lambda p: p.name):
        if not child.is_dir():
            continue
        if child.name in expected_custom_node_dirs:
            continue
        rel = str(child.relative_to(comfyui_dir)).replace("\\", "/")
        backup_name = f"entry-{len(records):04d}"
        dest = backup_root / backup_name
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(child, dest)
        records.append({
            "node_id": child.name,
            "install_relpath": rel,
            "existed": True,
            "backup_name": backup_name,
        })

manifest_path.write_text(json.dumps({"records": records}, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

bundle_apply_custom_nodes() {
    local bundle_dir="$1"
    local comfyui_dir="$2"
    require_python
    "${PYTHON_BIN}" - "$bundle_dir" "$comfyui_dir" <<'PY'
import json
import pathlib
import shutil
import sys

bundle_dir = pathlib.Path(sys.argv[1]).resolve()
comfyui_dir = pathlib.Path(sys.argv[2]).resolve()
plugins_path = bundle_dir / "state" / "plugins.json"
custom_nodes_root = comfyui_dir / "custom_nodes"

try:
    data = json.loads(plugins_path.read_text(encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"ERROR: failed to read bundle plugins registry: {exc}")

if not isinstance(data, list):
    raise SystemExit("ERROR: bundle plugins registry must be a JSON array")

def resolve_under(base: pathlib.Path, rel: str, label: str) -> pathlib.Path:
    rel_path = pathlib.Path(rel)
    if rel_path.is_absolute():
        raise SystemExit(f"ERROR: {label} must be relative: {rel}")
    target = (base / rel_path).resolve()
    try:
        target.relative_to(base)
    except Exception:
        raise SystemExit(f"ERROR: {label} escapes base directory: {rel}")
    return target

if custom_nodes_root.exists() and not custom_nodes_root.is_dir():
    raise SystemExit(f"ERROR: target custom_nodes root is not a directory: {custom_nodes_root}")

expected_custom_node_dirs = set()
entries = []
for item in data:
    if not isinstance(item, dict):
        continue
    node_id = str(item.get("id") or "").strip()
    if not node_id:
        raise SystemExit("ERROR: bundle plugins registry contains item without id")
    rel = str(item.get("install_relpath") or f"custom_nodes/{node_id}").strip()
    rel_path = pathlib.Path(rel)
    if len(rel_path.parts) >= 2 and rel_path.parts[0] == "custom_nodes":
        expected_custom_node_dirs.add(rel_path.parts[1])
    source = bundle_dir / "custom_nodes" / node_id
    if not source.exists() or not source.is_dir():
        raise SystemExit(f"ERROR: bundle custom_nodes payload missing for node '{node_id}': {source}")
    target = resolve_under(comfyui_dir, rel, f"install_relpath for node '{node_id}'")
    entries.append((node_id, source, target))

if custom_nodes_root.exists():
    for child in sorted(custom_nodes_root.iterdir(), key=lambda p: p.name):
        if child.is_dir() and child.name not in expected_custom_node_dirs:
            shutil.rmtree(child)

for node_id, source, target in entries:
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        if not target.is_dir():
            raise SystemExit(f"ERROR: target path is not a directory for node '{node_id}': {target}")
        shutil.rmtree(target)
    shutil.copytree(source, target)
PY
}

bundle_restore_custom_nodes() {
    local op_id="$1"
    local comfyui_dir="$2"
    require_python
    "${PYTHON_BIN}" - "${OPS_DIR}/${op_id}/backup" "$comfyui_dir" <<'PY'
import json
import pathlib
import shutil
import sys

backup_dir = pathlib.Path(sys.argv[1]).resolve()
comfyui_dir = pathlib.Path(sys.argv[2]).resolve()
manifest_path = backup_dir / "custom_nodes_manifest.json"
backup_root = backup_dir / "custom_nodes"
if not manifest_path.exists():
    raise SystemExit(0)

manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
records = manifest.get("records", [])

def resolve_under(base: pathlib.Path, rel: str, label: str) -> pathlib.Path:
    rel_path = pathlib.Path(rel)
    if rel_path.is_absolute():
        raise SystemExit(f"ERROR: {label} must be relative: {rel}")
    target = (base / rel_path).resolve()
    try:
        target.relative_to(base)
    except Exception:
        raise SystemExit(f"ERROR: {label} escapes base directory: {rel}")
    return target

for record in records:
    if not isinstance(record, dict):
        continue
    node_id = str(record.get("node_id") or "").strip()
    rel = str(record.get("install_relpath") or f"custom_nodes/{node_id}").strip()
    backup_name = str(record.get("backup_name") or "").strip()
    target = resolve_under(comfyui_dir, rel, f"install_relpath for node '{node_id}'")
    if target.exists():
        if target.is_dir():
            shutil.rmtree(target)
        else:
            target.unlink()
    if record.get("existed"):
        if not backup_name:
            raise SystemExit(f"ERROR: custom_nodes backup marker missing for node '{node_id}'")
        source = backup_root / backup_name
        if not source.exists() or not source.is_dir():
            raise SystemExit(f"ERROR: custom_nodes backup missing for node '{node_id}': {source}")
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(source, target)
PY
}

