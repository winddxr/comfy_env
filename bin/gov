extract_promotion_files() {
    local plan_json="$1"
    local pins_file="$2"
    local direct_out="$3"
    local override_out="$4"
    require_python
    "${PYTHON_BIN}" - "$plan_json" "$pins_file" "$direct_out" "$override_out" <<'PY'
import json
import pathlib
import sys

plan_path = pathlib.Path(sys.argv[1])
pins_path = pathlib.Path(sys.argv[2])
direct_out = pathlib.Path(sys.argv[3])
override_out = pathlib.Path(sys.argv[4])

plan = json.loads(plan_path.read_text(encoding="utf-8"))
direct = [x.strip() for x in plan.get("direct_additions", []) if str(x).strip()]
overrides = [x.strip() for x in plan.get("override_additions", []) if str(x).strip()]

pins = []
if pins_path.exists():
    pins = [line.strip() for line in pins_path.read_text(encoding="utf-8").splitlines() if line.strip()]

seen = set()
merged_override = []
for item in overrides + pins:
    if item not in seen:
        seen.add(item)
        merged_override.append(item)

direct_out.write_text("\n".join(sorted(set(direct))) + ("\n" if direct else ""), encoding="utf-8")
override_out.write_text("\n".join(merged_override) + ("\n" if merged_override else ""), encoding="utf-8")
PY
}

generate_promotion_plan() {
    local tx_file="$1"
    local plugin_path="$2"
    local out_json="$3"
    require_python
    "${PYTHON_BIN}" - "$tx_file" "$plugin_path" "$out_json" <<'PY'
import json
import pathlib
import re
import sys

tx_file = pathlib.Path(sys.argv[1])
plugin_path = pathlib.Path(sys.argv[2])
out_json = pathlib.Path(sys.argv[3])

tx = json.loads(tx_file.read_text(encoding="utf-8"))
added = tx.get("diff", {}).get("added", [])

def norm_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

def parse_req_names(base: pathlib.Path):
    names = set()
    for f in sorted(base.glob("requirements*.txt")):
        for raw in f.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith(("-r", "--", "-c")):
                continue
            if line.startswith(("git+", "http://", "https://")):
                continue
            n = norm_name(line)
            if n:
                names.add(n)
    return names

req_names = parse_req_names(plugin_path) if plugin_path.exists() else set()

name_to_spec = {}
for spec in added:
    spec = str(spec).strip()
    if not spec:
        continue
    n = norm_name(spec)
    if n and n not in name_to_spec:
        name_to_spec[n] = spec

direct = []
overrides = []
for name, spec in sorted(name_to_spec.items()):
    if name in req_names:
        direct.append(spec)
    else:
        overrides.append(spec)

payload = {
    "direct_additions": direct,
    "override_additions": overrides,
}
out_json.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}
write_conflict_report() {
    local txid="$1"
    local node_id="$2"
    local lock_log="$3"
    local out_json="${CONFLICT_DIR}/${txid}.json"
    require_python
    "${PYTHON_BIN}" - "$out_json" "$txid" "$node_id" "$lock_log" "$(timestamp_utc)" <<'PY'
import json
import pathlib
import re
import sys

out_path = pathlib.Path(sys.argv[1])
txid = sys.argv[2]
node_id = sys.argv[3]
lock_log = pathlib.Path(sys.argv[4])
created_at = sys.argv[5]

raw = ""
if lock_log.exists():
    raw = lock_log.read_text(encoding="utf-8", errors="ignore")

summary_lines = raw.splitlines()[:40]
packages = sorted(set(re.findall(r"([A-Za-z0-9_.-]+)==", raw)))

payload = {
    "txid": txid,
    "node_id": node_id,
    "created_at": created_at,
    "raw_log": str(lock_log),
    "summary": "\n".join(summary_lines),
    "detected_packages": packages,
    "input_hint": "Use: pkg==version",
}
out_path.write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
print(out_path)
PY
}

cmd_op_list() {
    ensure_layout
    require_python
    "${PYTHON_BIN}" - "$OPS_DIR" <<'PY'
import json
import pathlib
import sys

ops_dir = pathlib.Path(sys.argv[1])
items = []
for p in sorted([x for x in ops_dir.iterdir() if x.is_dir()], key=lambda x: x.name, reverse=True):
    meta = p / "meta.json"
    if not meta.exists():
        continue
    try:
        data = json.loads(meta.read_text(encoding="utf-8"))
    except Exception:
        continue
    items.append(data)

if not items:
    print("(no operations)")
else:
    for item in items:
        print(
            f"{item.get('op_id','')}  status={item.get('status','')}  kind={item.get('kind','')}  "
            f"ref={item.get('ref','')}  undoable={str(item.get('undoable', False)).lower()}  "
            f"started_at={item.get('started_at','')}"
        )
PY
}

cmd_op_inspect() {
    ensure_layout
    local op_id="${1:-}"
    if [ -z "$op_id" ]; then
        echo "Usage: gov op inspect <op_id>" >&2
        exit 1
    fi
    local meta_file="${OPS_DIR}/${op_id}/meta.json"
    if [ ! -f "$meta_file" ]; then
        echo "ERROR: operation not found: $op_id" >&2
        exit 2
    fi
    cat "$meta_file"
}

cmd_undo() {
    require_cmd uv
    ensure_layout
    require_python
    local py
    py="$(configured_python)"

    local op_id="${1:-}"
    if [ -z "$op_id" ]; then
        echo "Usage: gov undo <op_id>" >&2
        exit 1
    fi

    local meta_file
    meta_file="${OPS_DIR}/${op_id}/meta.json"
    if [ ! -f "$meta_file" ]; then
        echo "ERROR: operation not found: $op_id" >&2
        exit 2
    fi

    if ! "${PYTHON_BIN}" - "$meta_file" "$(file_sha256 "$PROJECT_FILE")" "$(file_sha256 "$LOCK_FILE")" "$(file_sha256 "$PLUGINS_FILE")" <<'PY'
import json
import pathlib
import sys

meta = pathlib.Path(sys.argv[1])
current = {
    "pyproject.toml": sys.argv[2],
    "uv.lock": sys.argv[3],
    "plugins.json": sys.argv[4],
}
data = json.loads(meta.read_text(encoding="utf-8"))
if data.get("status") != "success" or not data.get("undoable", False):
    print("ERROR: target operation is not undoable", file=sys.stderr)
    raise SystemExit(10)

files = data.get("files", {})
for key, now_hash in current.items():
    want = ((files.get(key) or {}).get("post_sha256") or "")
    if want != now_hash:
        print(f"ERROR: current state diverged for {key}; expected {want}, got {now_hash}", file=sys.stderr)
        raise SystemExit(11)
PY
    then
        exit 1
    fi

    local undo_op_id prod_env
    undo_op_id="$(op_begin "manual" "undo:${op_id}")"

    if ! op_restore_backup "$op_id"; then
        op_restore_backup "$undo_op_id" || true
        op_finalize "$undo_op_id" "failed" "false" "undo failed: missing target backup"
        exit 1
    fi

    prod_env="$(prod_env_path)"
    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        op_restore_backup "$undo_op_id" || true
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$undo_op_id" "failed" "false" "undo failed: prod sync failed"
        exit 1
    fi

    "${PYTHON_BIN}" - "$meta_file" "$undo_op_id" "$(timestamp_utc)" <<'PY'
import json
import pathlib
import sys

meta = pathlib.Path(sys.argv[1])
undo_op_id = sys.argv[2]
ended_at = sys.argv[3]
data = json.loads(meta.read_text(encoding="utf-8"))
data["status"] = "undone"
data["undoable"] = False
data["ended_at"] = ended_at
data["note"] = f"undone by {undo_op_id}"
meta.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY

    op_finalize "$undo_op_id" "success" "true" "undo succeeded for ${op_id}"
    ops_prune

    echo "Undo complete."
    echo "  target_op_id: $op_id"
    echo "  undo_op_id: $undo_op_id"
}

write_tx_file() {
    local tx_file="$1"
    local txid="$2"
    local node_id="$3"
    local status="$4"
    local started_at="$5"
    local ended_at="$6"
    local candidate_env="$7"
    local pre_file="$8"
    local post_file="$9"
    local stdout_log="${10}"
    local stderr_log="${11}"
    local run_exit_code="${12}"
    local core_csv="${13}"
    require_python

    "${PYTHON_BIN}" - "$tx_file" "$txid" "$node_id" "$status" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "$run_exit_code" "$core_csv" <<'PY'
import json
import pathlib
import re
import sys

(
    tx_file,
    txid,
    node_id,
    status,
    started_at,
    ended_at,
    candidate_env,
    pre_file,
    post_file,
    stdout_log,
    stderr_log,
    run_exit_code,
    core_csv,
) = sys.argv[1:14]

def read_lines(path: str):
    p = pathlib.Path(path)
    if not p.exists():
        return []
    return [line.strip() for line in p.read_text(encoding="utf-8").splitlines() if line.strip()]

def normalize_name(spec: str):
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

pre = read_lines(pre_file)
post = read_lines(post_file)
added = sorted(set(post) - set(pre))
removed = sorted(set(pre) - set(post))
core_set = {x.strip().lower() for x in core_csv.split(",") if x.strip()}
core_impact = sorted({n for n in [normalize_name(x) for x in added + removed] if n in core_set})

payload = {
    "txid": txid,
    "kind": "plugin",
    "subject": node_id,
    "node_id": node_id,
    "started_at": started_at,
    "ended_at": ended_at,
    "candidate_env": candidate_env,
    "status": status,
    "pre_freeze": pre,
    "post_freeze": post,
    "diff": {
        "added": added,
        "removed": removed,
    },
    "core_impact": core_impact,
    "logs": {
        "stdout": stdout_log,
        "stderr": stderr_log,
        "run_exit_code": int(run_exit_code),
    },
    "source_requirements_path": "",
    "source_requirements_sha256": "",
    "staged_workdir": "",
    "target_core_deps": [],
    "conflict_report": "",
    "resolution_pins": [],
    "promotion_plan": {
        "direct_additions": [],
        "override_additions": [],
    },
    "promotion": {
        "status": "",
        "reason": "",
        "op_id": "",
        "pre_op_id": "",
        "error": "",
    },
}

pathlib.Path(tx_file).write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

write_update_tx_file() {
    local tx_file="$1"
    local txid="$2"
    local status="$3"
    local started_at="$4"
    local ended_at="$5"
    local candidate_env="$6"
    local pre_file="$7"
    local post_file="$8"
    local stdout_log="$9"
    local stderr_log="${10}"
    local run_exit_code="${11}"
    local core_csv="${12}"
    local requirements_path="${13}"
    local requirements_sha="${14}"
    local staged_workdir="${15}"
    local target_core_deps_file="${16}"
    require_python

    "${PYTHON_BIN}" - "$tx_file" "$txid" "$status" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "$run_exit_code" "$core_csv" "$requirements_path" "$requirements_sha" "$staged_workdir" "$target_core_deps_file" <<'PY'
import json
import pathlib
import re
import sys

(
    tx_file,
    txid,
    status,
    started_at,
    ended_at,
    candidate_env,
    pre_file,
    post_file,
    stdout_log,
    stderr_log,
    run_exit_code,
    core_csv,
    requirements_path,
    requirements_sha,
    staged_workdir,
    target_core_deps_file,
) = sys.argv[1:17]

def read_lines(path: str):
    p = pathlib.Path(path)
    if not p.exists():
        return []
    return [line.strip() for line in p.read_text(encoding="utf-8").splitlines() if line.strip()]

def normalize_name(spec: str):
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

pre = read_lines(pre_file)
post = read_lines(post_file)
added = sorted(set(post) - set(pre))
removed = sorted(set(pre) - set(post))
core_set = {x.strip().lower() for x in core_csv.split(",") if x.strip()}
core_impact = sorted({n for n in [normalize_name(x) for x in added + removed] if n in core_set})
target_core_deps = read_lines(target_core_deps_file)

payload = {
    "txid": txid,
    "kind": "core_update",
    "subject": "core",
    "node_id": "core",
    "started_at": started_at,
    "ended_at": ended_at,
    "candidate_env": candidate_env,
    "status": status,
    "pre_freeze": pre,
    "post_freeze": post,
    "diff": {
        "added": added,
        "removed": removed,
    },
    "core_impact": core_impact,
    "logs": {
        "stdout": stdout_log,
        "stderr": stderr_log,
        "run_exit_code": int(run_exit_code),
    },
    "source_requirements_path": requirements_path,
    "source_requirements_sha256": requirements_sha,
    "staged_workdir": staged_workdir,
    "target_core_deps": target_core_deps,
    "conflict_report": "",
    "resolution_pins": [],
    "promotion_plan": {
        "direct_additions": [],
        "override_additions": [],
    },
    "promotion": {
        "status": "",
        "reason": "",
        "op_id": "",
        "pre_op_id": "",
        "error": "",
    },
}

pathlib.Path(tx_file).write_text(json.dumps(payload, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY
}

tx_assert_kind() {
    local expected="$1"
    local actual
    actual="$(tx_get_field "$TX_FILE" "kind" "plugin")"
    if [ "$actual" != "$expected" ]; then
        echo "ERROR: transaction kind '$actual' is not supported by this command" >&2
        exit 1
    fi
}

cmd_init() {
    require_cmd uv
    local comfyui_dir_override=""
    local python_override=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --comfyui-dir)
                comfyui_dir_override="${2:-}"
                shift 2
                ;;
            --python)
                python_override="${2:-}"
                shift 2
                ;;
            *)
                echo "Usage: gov init --comfyui-dir <abs-path> --python <python-spec>" >&2
                exit 1
                ;;
        esac
    done

    local resolved_python_override=""
    if [ -n "$python_override" ]; then
        resolved_python_override="$(resolve_python_minor "$python_override")"
    fi

    ensure_layout
    ensure_config_file_for_init "$comfyui_dir_override" "$resolved_python_override"
    ensure_project_file_for_init

    local prod_env py comfyui_dir environment_marker
    comfyui_dir="$(comfyui_dir_path)"
    py="$(canonicalize_python_minor "$(configured_python)")"
    ensure_config_file_for_init "$comfyui_dir" "$py"
    environment_marker="$(current_uv_environment_marker)"
    sync_project_runtime_constraints "$PROJECT_FILE" "$py" "$environment_marker"
    prod_env="$(prod_env_path)"

    lock_project_exact "$ROOT_DIR" "$py"
    sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"

    echo "Initialized."
    echo "  root: $ROOT_DIR"
    echo "  comfyui dir: $comfyui_dir"
    echo "  python: $py"
    echo "  prod env: $prod_env"
    echo "  lock file: $LOCK_FILE"
}

cmd_node_add() {
    require_cmd git
    ensure_layout

    local git_url="${1:-}"
    shift || true
    if [ -z "$git_url" ]; then
        echo "Usage: gov node add <git_url> [--ref <sha/tag>] [--id <node_id>]" >&2
        exit 1
    fi

    local ref=""
    local node_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --ref)
                ref="${2:-}"
                shift 2
                ;;
            --id)
                node_id="${2:-}"
                shift 2
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$node_id" ]; then
        node_id="$(basename "$git_url")"
        node_id="${node_id%.git}"
    fi

    local comfyui_dir custom_nodes_dir target_dir
    comfyui_dir="$(comfyui_dir_path)"
    custom_nodes_dir="${comfyui_dir}/custom_nodes"
    target_dir="${custom_nodes_dir}/${node_id}"

    mkdir -p "$custom_nodes_dir"
    if [ -e "$target_dir" ]; then
        echo "ERROR: node target already exists: $target_dir" >&2
        exit 1
    fi

    git clone "$git_url" "$target_dir"
    if [ -n "$ref" ]; then
        git -C "$target_dir" checkout "$ref"
    fi

    require_python
    "${PYTHON_BIN}" - "$PLUGINS_FILE" "$node_id" "$git_url" "$ref" "custom_nodes/${node_id}" "$(timestamp_utc)" <<'PY'
import json
import pathlib
import re
import sys

plugins_file = pathlib.Path(sys.argv[1])
node_id = sys.argv[2]
git_url = sys.argv[3]
ref = sys.argv[4]
install_relpath = sys.argv[5]
ts_now = sys.argv[6]

try:
    data = json.loads(plugins_file.read_text(encoding="utf-8")) if plugins_file.exists() else []
except Exception:
    data = []

if not isinstance(data, list):
    data = []

data = [x for x in data if not (isinstance(x, dict) and x.get("id") == node_id)]
data.append({
    "id": node_id,
    "git_url": git_url,
    "ref": ref,
    "install_relpath": install_relpath,
    "group": f"node-{re.sub(r'[-_.]+', '-', node_id.lower()).strip('-')}",
    "enabled": True,
    "managed_deps": [],
    "created_at": ts_now,
    "updated_at": ts_now,
})

plugins_file.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n", encoding="utf-8")
PY

    echo "Node added."
    echo "  id: $node_id"
    echo "  path: $target_dir"
}
cmd_node_remove() {
    require_cmd uv
    ensure_layout
    local py
    py="$(configured_python)"

    local node_id="${1:-}"
    shift || true
    if [ -z "$node_id" ]; then
        echo "Usage: gov node remove <node_id> [--purge-code]" >&2
        exit 1
    fi

    local purge_code=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --purge-code)
                purge_code=true
                shift
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    local meta_json deps_file
    meta_json="$(mktemp)"
    deps_file="$(mktemp)"
    if ! plugin_get_meta "$node_id" "$meta_json"; then
        rm -f "$meta_json" "$deps_file"
        echo "ERROR: node not found: $node_id" >&2
        exit 2
    fi

    local group plugin_relpath plugin_path
    { read -r plugin_relpath; read -r group; } < <(plugin_meta_fields "$meta_json")
    group="$(normalize_group_name "$group")"
    if [ -z "$group" ]; then
        group="$(group_name_for_node "$node_id")"
    fi
    plugin_path="$(plugin_install_abs_path "$plugin_relpath")"

    local op_id
    op_id="$(op_begin "remove" "$node_id")"

    local workdir lock_log
    workdir="$(build_workdir_for_tx "remove-${node_id}")"
    lock_log="${LOG_DIR}/remove-${node_id}.lock.log"
    write_group_deps "$workdir/pyproject.toml" "$group" "$deps_file"

    (
        cd "$workdir"
        if [ -s "$deps_file" ]; then
            while IFS= read -r dep; do
                [ -z "$dep" ] && continue
                uv remove --group "$group" --python "$py" --no-sync "$dep" || true
            done < "$deps_file"
        fi
        uv lock --python "$py"
    ) >"$lock_log" 2>&1 || {
        op_restore_backup "$op_id" || true
        op_finalize "$op_id" "failed" "false" "node remove lock failed"
        rm -f "$meta_json" "$deps_file"
        echo "ERROR: node remove lock failed. See $lock_log" >&2
        exit 1
    }

    cp "$workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$workdir/uv.lock" "$LOCK_FILE"

    local prod_env
    prod_env="$(prod_env_path)"
    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed during node remove, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "prod sync failed"
        rm -f "$meta_json" "$deps_file"
        exit 1
    fi

    plugin_remove_record "$node_id"

    if [ "$purge_code" = true ] && [ -n "$plugin_path" ] && [ -d "$plugin_path" ]; then
        rm -rf "$plugin_path"
    fi

    op_finalize "$op_id" "success" "true" "node remove succeeded; purge_code=${purge_code}"
    ops_prune

    rm -f "$meta_json" "$deps_file"

    echo "Node removed."
    echo "  id: $node_id"
    echo "  op_id: $op_id"
    if [ "$purge_code" = true ]; then
        echo "  note: code purge is irreversible; undo will not restore plugin files"
    fi
}

cmd_tx_run() {
    require_cmd uv
    ensure_layout
    local py
    py="$(configured_python)"

    local node_id="${1:-}"
    shift || true
    if [ -z "$node_id" ]; then
        echo "Usage: gov tx run <node_id> [--timeout <seconds>]" >&2
        exit 1
    fi

    local timeout_sec
    timeout_sec="$(tx_timeout_seconds)"
    while [ $# -gt 0 ]; do
        case "$1" in
            --timeout)
                timeout_sec="${2:-}"
                shift 2
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    if ! ensure_plugin_exists "$node_id"; then
        echo "ERROR: node not found in plugins registry: $node_id" >&2
        exit 1
    fi

    local txid candidate_root candidate_env pre_file post_file stdout_log stderr_log started_at ended_at run_exit_code status
    txid="$(new_txid)"
    candidate_root="$(candidate_root_path)"
    candidate_env="${candidate_root}/${txid}"
    TX_FILE="${TX_DIR}/${txid}.json"
    pre_file="${TX_DIR}/${txid}.pre.freeze.txt"
    post_file="${TX_DIR}/${txid}.post.freeze.txt"
    stdout_log="${LOG_DIR}/${txid}.stdout.log"
    stderr_log="${LOG_DIR}/${txid}.stderr.log"

    started_at="$(timestamp_utc)"
    run_exit_code=0

    mkdir -p "$candidate_root"
    : > "$pre_file"
    : > "$post_file"
    : > "$stdout_log"
    : > "$stderr_log"

    write_tx_file "$TX_FILE" "$txid" "$node_id" "running" "$started_at" "" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "-1" "$(core_packages_csv)"

    if [ ! -f "$LOCK_FILE" ]; then
        lock_project_exact "$ROOT_DIR" "$py"
    fi
    sync_project_env_exact "$ROOT_DIR" "$candidate_env" "$py"

    collect_freeze_file "$candidate_env" "$pre_file"

    local comfyui_dir main_py
    comfyui_dir="$(comfyui_dir_path)"
    main_py="${comfyui_dir}/main.py"

    set +e
    if [ -f "$main_py" ]; then
        if command -v timeout >/dev/null 2>&1; then
            timeout "${timeout_sec}s" "$candidate_env/bin/python" "$main_py" >"$stdout_log" 2>"$stderr_log"
            run_exit_code=$?
        else
            "$candidate_env/bin/python" "$main_py" >"$stdout_log" 2>"$stderr_log"
            run_exit_code=$?
        fi
    else
        echo "ComfyUI entry not found: $main_py" >"$stderr_log"
        run_exit_code=2
    fi
    set -e

    collect_freeze_file "$candidate_env" "$post_file"

    ended_at="$(timestamp_utc)"
    status="completed"
    if [ "$run_exit_code" -ne 0 ]; then
        status="failed"
    fi

    write_tx_file "$TX_FILE" "$txid" "$node_id" "$status" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "$run_exit_code" "$(core_packages_csv)"

    echo "Transaction recorded."
    echo "  txid: $txid"
    echo "  status: $status"
    echo "  file: $TX_FILE"
}

cmd_tx_inspect() {
    local txid="${1:-}"
    if [ -z "$txid" ]; then
        echo "Usage: gov tx inspect <txid>" >&2
        exit 1
    fi
    load_tx "$txid"
    tx_assert_kind "plugin"

    require_python
    "${PYTHON_BIN}" - "$TX_FILE" <<'PY'
import json
import pathlib
import sys

tx = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(f"txid: {tx.get('txid')}")
print(f"node_id: {tx.get('node_id')}")
print(f"status: {tx.get('status')}")
print(f"started_at: {tx.get('started_at')}")
print(f"ended_at: {tx.get('ended_at')}")
print(f"candidate_env: {tx.get('candidate_env')}")
diff = tx.get("diff", {})
print(f"added_count: {len(diff.get('added', []))}")
print(f"removed_count: {len(diff.get('removed', []))}")
core = tx.get("core_impact", [])
print(f"core_impact: {', '.join(core) if core else '(none)'}")
print(f"conflict_report: {tx.get('conflict_report') or '(none)'}")
print(f"resolution_pins: {len(tx.get('resolution_pins', []))}")
prom = tx.get("promotion", {})
print(f"promotion_status: {prom.get('status') or '(none)'}")
logs = tx.get("logs", {})
print(f"stdout_log: {logs.get('stdout', '')}")
print(f"stderr_log: {logs.get('stderr', '')}")
print(f"run_exit_code: {logs.get('run_exit_code', '')}")
PY
}

_cmd_abort_impl() {
    local txid="$1"
    local expected_kind="$2"
    local label="$3"

    load_tx "$txid"
    tx_assert_kind "$expected_kind"

    local candidate_env staged_workdir
    candidate_env="$(tx_get_field "$TX_FILE" "candidate_env" "")"
    staged_workdir="$(tx_get_field "$TX_FILE" "staged_workdir" "")"

    if [ -n "$candidate_env" ] && [ -d "$candidate_env" ]; then
        rm -rf "$candidate_env"
    fi
    if [ -n "$staged_workdir" ] && [ -d "$staged_workdir" ]; then
        rm -rf "$staged_workdir"
    fi

    tx_update_status "$TX_FILE" "aborted"
    echo "${label} aborted."
    echo "  txid: $txid"
}

cmd_tx_abort() {
    local txid="${1:-}"
    if [ -z "$txid" ]; then
        echo "Usage: gov tx abort <txid>" >&2
        exit 1
    fi
    _cmd_abort_impl "$txid" "plugin" "Transaction"
}
cmd_resolve() {
    require_cmd uv
    require_python
    ensure_layout

    local txid="${1:-}"
    if [ -z "$txid" ]; then
        echo "Usage: gov resolve <txid>" >&2
        exit 1
    fi

    load_tx "$txid"
    tx_assert_kind "plugin"

    local status node_id conflict_report
    status="$(tx_get_field "$TX_FILE" "status" "")"
    node_id="$(tx_get_field "$TX_FILE" "node_id" "")"
    conflict_report="$(tx_get_field "$TX_FILE" "conflict_report" "")"

    case "$status" in
        needs_resolution|promote_failed|resolved)
            ;;
        *)
            echo "ERROR: tx status '$status' is not resolvable" >&2
            exit 1
            ;;
    esac

    if [ -n "$conflict_report" ] && [ -f "$conflict_report" ]; then
        echo "=== Conflict Summary ==="
        "${PYTHON_BIN}" - "$conflict_report" <<'PY'
import json
import pathlib
import sys
r = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(r.get("summary", "(no summary)"))
PY
        echo "========================"
    fi

    local new_pins merged_pins
    new_pins="$(mktemp)"
    merged_pins="$(mktemp)"

    echo "Input pins as pkg==version (empty line to finish):"
    while true; do
        local line
        IFS= read -r line || true
        [ -z "$line" ] && break
        if [[ ! "$line" =~ ^[A-Za-z0-9_.-]+==[^[:space:]]+$ ]]; then
            echo "Invalid pin format: $line" >&2
            continue
        fi
        echo "$line" >> "$new_pins"
    done

    require_python
    "${PYTHON_BIN}" - "$TX_FILE" "$new_pins" "$merged_pins" <<'PY'
import json
import pathlib
import sys

tx = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
new_pins = pathlib.Path(sys.argv[2])
out = pathlib.Path(sys.argv[3])

extra = []
if new_pins.exists():
    extra = [x.strip() for x in new_pins.read_text(encoding="utf-8").splitlines() if x.strip()]

seen = set()
merged = []
for item in tx.get("resolution_pins", []) + extra:
    if item not in seen:
        seen.add(item)
        merged.append(item)

out.write_text("\n".join(merged) + ("\n" if merged else ""), encoding="utf-8")
PY

    local meta_json group plugin_relpath plugin_path plan_json workdir direct_file override_file lock_log report
    meta_json="$(mktemp)"
    if ! plugin_get_meta "$node_id" "$meta_json"; then
        rm -f "$meta_json" "$new_pins" "$merged_pins"
        echo "ERROR: plugin metadata missing for node_id=$node_id" >&2
        exit 1
    fi

    { read -r plugin_relpath; read -r group; } < <(plugin_meta_fields "$meta_json")
    plugin_path="$(plugin_install_abs_path "$plugin_relpath")"
    group="$(normalize_group_name "$group")"
    if [ -z "$group" ]; then
        group="$(group_name_for_node "$node_id")"
    fi

    plan_json="$(mktemp)"
    generate_promotion_plan "$TX_FILE" "$plugin_path" "$plan_json"
    tx_set_plan "$TX_FILE" "$plan_json"

    workdir="$(build_workdir_for_tx "$txid")"
    direct_file="${WORK_DIR}/${txid}.resolve.direct.txt"
    override_file="${WORK_DIR}/${txid}.resolve.override.txt"
    extract_promotion_files "$plan_json" "$merged_pins" "$direct_file" "$override_file"

    lock_log="${CONFLICT_DIR}/${txid}.resolve.lock.log"
    if apply_plan_in_workdir "$workdir" "$group" "$direct_file" "$override_file" "$lock_log"; then
        tx_set_resolution_pins "$TX_FILE" "$merged_pins" "resolved"
        echo "Resolve succeeded."
        echo "  txid: $txid"
        echo "  status: resolved"
    else
        report="$(write_conflict_report "$txid" "$node_id" "$lock_log")"
        tx_set_resolution_pins "$TX_FILE" "$merged_pins" "needs_resolution"
        tx_set_conflict "$TX_FILE" "$report" "needs_resolution" "true" ""
        echo "Resolve failed."
        echo "  txid: $txid"
        echo "  conflict_report: $report"
        rm -f "$meta_json" "$new_pins" "$merged_pins" "$plan_json"
        exit 2
    fi

    rm -f "$meta_json" "$new_pins" "$merged_pins" "$plan_json"
}

cmd_tx_promote() {
    require_cmd uv
    require_python
    ensure_layout
    local py
    py="$(configured_python)"

    local txid="${1:-}"
    shift || true
    if [ -z "$txid" ]; then
        echo "Usage: gov tx promote <txid> [--approve-core --reason \"...\"] [--allow-failed-run]" >&2
        exit 1
    fi

    local approve_core=false
    local reason=""
    local allow_failed_run=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --approve-core)
                approve_core=true
                shift
                ;;
            --reason)
                reason="${2:-}"
                shift 2
                ;;
            --allow-failed-run)
                allow_failed_run=true
                shift
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    load_tx "$txid"
    tx_assert_kind "plugin"

    local status node_id core_count
    status="$(tx_get_field "$TX_FILE" "status" "")"
    node_id="$(tx_get_field "$TX_FILE" "node_id" "")"
    core_count="$(tx_get_field "$TX_FILE" "core_impact" "" | sed '/^$/d' | wc -l | tr -d ' ')"

    case "$status" in
        completed|resolved)
            ;;
        failed)
            if [ "$allow_failed_run" != true ]; then
                echo "ERROR: tx status is failed. Use --allow-failed-run to continue." >&2
                exit 1
            fi
            ;;
        *)
            echo "ERROR: tx status '$status' cannot be promoted" >&2
            exit 1
            ;;
    esac

    if [ "$core_count" != "0" ] && [ "$approve_core" != true ]; then
        echo "ERROR: core package impact detected. Use --approve-core to continue." >&2
        exit 1
    fi

    local meta_json group plugin_relpath plugin_path op_id workdir plan_json pins_file direct_file override_file lock_log conflict_report
    meta_json="$(mktemp)"
    if ! plugin_get_meta "$node_id" "$meta_json"; then
        rm -f "$meta_json"
        echo "ERROR: plugin metadata missing for node=$node_id" >&2
        exit 1
    fi

    { read -r plugin_relpath; read -r group; } < <(plugin_meta_fields "$meta_json")
    plugin_path="$(plugin_install_abs_path "$plugin_relpath")"
    group="$(normalize_group_name "$group")"
    if [ -z "$group" ]; then
        group="$(group_name_for_node "$node_id")"
    fi

    op_id="$(op_begin "promote" "$txid")"

    workdir="$(build_workdir_for_tx "$txid")"
    plan_json="$(mktemp)"
    generate_promotion_plan "$TX_FILE" "$plugin_path" "$plan_json"
    tx_set_plan "$TX_FILE" "$plan_json"

    pins_file="$(mktemp)"
    tx_get_field "$TX_FILE" "resolution_pins" "" > "$pins_file" || true

    direct_file="${WORK_DIR}/${txid}.promote.direct.txt"
    override_file="${WORK_DIR}/${txid}.promote.override.txt"
    extract_promotion_files "$plan_json" "$pins_file" "$direct_file" "$override_file"

    lock_log="${CONFLICT_DIR}/${txid}.promote.lock.log"
    if ! apply_plan_in_workdir "$workdir" "$group" "$direct_file" "$override_file" "$lock_log"; then
        conflict_report="$(write_conflict_report "$txid" "$node_id" "$lock_log")"
        tx_set_conflict "$TX_FILE" "$conflict_report" "needs_resolution" "true" "$op_id"
        op_restore_backup "$op_id" || true
        op_finalize "$op_id" "failed" "false" "promote lock conflict"
        echo "Promote blocked by lock conflict."
        echo "  txid: $txid"
        echo "  conflict_report: $conflict_report"
        rm -f "$meta_json" "$plan_json" "$pins_file"
        exit 2
    fi

    cp "$workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$workdir/uv.lock" "$LOCK_FILE"

    local prod_env
    prod_env="$(prod_env_path)"
    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        tx_set_promote_failed "$TX_FILE" "$op_id" "prod sync failed"
        op_finalize "$op_id" "failed" "false" "prod sync failed"
        rm -f "$meta_json" "$plan_json" "$pins_file"
        exit 1
    fi

    local comfyui_dir
    comfyui_dir="$(comfyui_dir_path)"
    if ! run_smoke_test_in_env "$prod_env" "$comfyui_dir"; then
        echo "ERROR: smoke test failed, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        tx_set_promote_failed "$TX_FILE" "$op_id" "smoke test failed"
        op_finalize "$op_id" "failed" "false" "smoke test failed"
        rm -f "$meta_json" "$plan_json" "$pins_file"
        exit 1
    fi

    tx_set_promoted "$TX_FILE" "$op_id" "$reason"
    plugin_update_after_promote "$node_id" "$PROJECT_FILE"
    op_finalize "$op_id" "success" "true" "promote succeeded"
    ops_prune

    echo "Promote successful."
    echo "  txid: $txid"
    echo "  op_id: $op_id"

    rm -f "$meta_json" "$plan_json" "$pins_file"
}
cmd_install_torch() {
    require_cmd uv
    ensure_layout
    ensure_project_file_for_init

    local index_url=""
    local torch_spec=""
    local torchvision_spec=""
    local torchaudio_spec=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --index-url)
                index_url="${2:-}"
                shift 2
                ;;
            --torch)
                torch_spec="${2:-}"
                shift 2
                ;;
            --torchvision)
                torchvision_spec="${2:-}"
                shift 2
                ;;
            --torchaudio)
                torchaudio_spec="${2:-}"
                shift 2
                ;;
            *)
                echo "Usage: gov install torch --index-url <url> [--torch <torch==version>] [--torchvision <torchvision==version>] [--torchaudio <torchaudio==version>]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$index_url" ]; then
        echo "Usage: gov install torch --index-url <url> [--torch <torch==version>] [--torchvision <torchvision==version>] [--torchaudio <torchaudio==version>]" >&2
        exit 1
    fi

    local custom_torch_specs=false
    local dep_name
    for dep_name in torch torchvision torchaudio; do
        local spec_value=""
        case "$dep_name" in
            torch)
                spec_value="$torch_spec"
                ;;
            torchvision)
                spec_value="$torchvision_spec"
                ;;
            torchaudio)
                spec_value="$torchaudio_spec"
                ;;
        esac
        if [ -n "$spec_value" ]; then
            custom_torch_specs=true
            if [[ ! "$spec_value" =~ ^[A-Za-z0-9_.-]+==[^[:space:]]+$ ]]; then
                echo "ERROR: invalid ${dep_name} spec: $spec_value (expected ${dep_name}==version)" >&2
                exit 1
            fi
            if [ "$(normalize_dep_name "$spec_value")" != "$dep_name" ]; then
                echo "ERROR: ${dep_name} flag must target package '${dep_name}': $spec_value" >&2
                exit 1
            fi
        fi
    done

    local py prod_env workdir index_name op_id
    py="$(configured_python)"
    prod_env="$(prod_env_path)"
    workdir="$(build_workdir_for_tx "install-torch")"
    index_name="$(torch_index_name_from_url "$index_url")"

    if ! (
        cd "$workdir"
        uv add --group torch --python "$py" --index "${index_name}=${index_url}" --no-sync torch torchvision torchaudio
    ); then
        echo "ERROR: install torch failed during staging" >&2
        exit 1
    fi

    if [ "$custom_torch_specs" = true ]; then
        local -a desired_torch_specs=("torch" "torchvision" "torchaudio")
        [ -n "$torch_spec" ] && desired_torch_specs[0]="$torch_spec"
        [ -n "$torchvision_spec" ] && desired_torch_specs[1]="$torchvision_spec"
        [ -n "$torchaudio_spec" ] && desired_torch_specs[2]="$torchaudio_spec"
        if ! rewrite_dependency_group "$workdir/pyproject.toml" "torch" "replace_exact" "${desired_torch_specs[@]}"; then
            echo "ERROR: install torch failed while updating managed torch specs" >&2
            exit 1
        fi
    fi

    if ! lock_project_exact "$workdir" "$py"; then
        echo "ERROR: install torch failed during lock" >&2
        exit 1
    fi

    if files_are_identical "$PROJECT_FILE" "$workdir/pyproject.toml" && files_are_identical "$LOCK_FILE" "$workdir/uv.lock"; then
        echo "No changes."
        echo "  group: torch"
        return 0
    fi

    op_id="$(op_begin "install_torch" "$index_url")"
    cp "$workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$workdir/uv.lock" "$LOCK_FILE"

    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed during install torch, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "install torch failed: prod sync failed"
        exit 1
    fi

    if ! "$prod_env/bin/python" -c "import torch, torchvision, torchaudio" >/dev/null 2>&1; then
        echo "ERROR: torch smoke test failed, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "install torch failed: smoke test failed"
        exit 1
    fi

    op_finalize "$op_id" "success" "true" "install torch succeeded"
    ops_prune

    echo "Torch dependencies installed."
    echo "  op_id: $op_id"
    echo "  index: ${index_name}=${index_url}"
    if [ "$custom_torch_specs" = true ]; then
        echo "  managed specs: torch=${torch_spec:-torch} torchvision=${torchvision_spec:-torchvision} torchaudio=${torchaudio_spec:-torchaudio}"
    fi
}

cmd_install_core() {
    require_cmd uv
    ensure_layout
    ensure_project_file_for_init

    local requirements_file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --requirements-file)
                requirements_file="${2:-}"
                shift 2
                ;;
            *)
                echo "Usage: gov install [--requirements-file <path>]" >&2
                exit 1
                ;;
        esac
    done

    if ! torch_group_ready; then
        echo "ERROR: managed torch dependencies are not installed. Run 'gov install torch --index-url <url>' first." >&2
        exit 1
    fi

    if [ -z "$requirements_file" ]; then
        requirements_file="$(default_requirements_file)"
    fi

    local py prod_env workdir deps_file op_id
    py="$(configured_python)"
    prod_env="$(prod_env_path)"
    deps_file="$(mktemp)"
    read_requirements_file_exact "$requirements_file" "$deps_file"
    workdir="$(build_workdir_for_tx "install-core")"

    set_dependency_group_exact "$workdir" "core" "$deps_file"
    lock_project_exact "$workdir" "$py"

    if files_are_identical "$PROJECT_FILE" "$workdir/pyproject.toml" && files_are_identical "$LOCK_FILE" "$workdir/uv.lock"; then
        rm -f "$deps_file"
        echo "No changes."
        echo "  group: core"
        return 0
    fi

    op_id="$(op_begin "install_core" "$requirements_file")"
    cp "$workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$workdir/uv.lock" "$LOCK_FILE"

    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed during install, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "install core failed: prod sync failed"
        rm -f "$deps_file"
        exit 1
    fi

    local comfyui_dir
    comfyui_dir="$(comfyui_dir_path)"
    if ! run_smoke_test_in_env "$prod_env" "$comfyui_dir"; then
        echo "ERROR: smoke test failed during install, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "install core failed: smoke test failed"
        rm -f "$deps_file"
        exit 1
    fi

    op_finalize "$op_id" "success" "true" "install core succeeded"
    ops_prune
    rm -f "$deps_file"

    echo "Core requirements installed."
    echo "  op_id: $op_id"
    echo "  requirements: $requirements_file"
}

cmd_update_run() {
    require_cmd uv
    ensure_layout
    ensure_project_file_for_init

    local requirements_file=""
    local timeout_sec
    timeout_sec="$(tx_timeout_seconds)"
    while [ $# -gt 0 ]; do
        case "$1" in
            --requirements-file)
                requirements_file="${2:-}"
                shift 2
                ;;
            --timeout)
                timeout_sec="${2:-}"
                shift 2
                ;;
            *)
                echo "Usage: gov update run [--requirements-file <path>] [--timeout <seconds>]" >&2
                exit 1
                ;;
        esac
    done

    if ! torch_group_ready; then
        echo "ERROR: managed torch dependencies are not installed. Run 'gov install torch --index-url <url>' first." >&2
        exit 1
    fi

    if [ -z "$requirements_file" ]; then
        requirements_file="$(default_requirements_file)"
    fi

    local py prod_env txid workdir candidate_root candidate_env pre_file post_file stdout_log stderr_log deps_file started_at ended_at run_exit_code status req_sha lock_log conflict_report main_py comfyui_dir
    py="$(configured_python)"
    prod_env="$(prod_env_path)"
    if [ ! -d "$prod_env" ]; then
        echo "ERROR: prod environment not found: $prod_env" >&2
        echo "Hint: run 'gov init --comfyui-dir <abs-path> --python <python-spec>' first." >&2
        exit 1
    fi

    txid="$(new_txid)"
    workdir="$(build_workdir_for_tx "$txid")"
    candidate_root="$(candidate_root_path)"
    candidate_env="${candidate_root}/${txid}"
    TX_FILE="${TX_DIR}/${txid}.json"
    pre_file="${TX_DIR}/${txid}.pre.freeze.txt"
    post_file="${TX_DIR}/${txid}.post.freeze.txt"
    stdout_log="${LOG_DIR}/${txid}.stdout.log"
    stderr_log="${LOG_DIR}/${txid}.stderr.log"
    deps_file="$(mktemp)"
    lock_log="${CONFLICT_DIR}/${txid}.update.lock.log"

    mkdir -p "$candidate_root"
    : > "$pre_file"
    : > "$post_file"
    : > "$stdout_log"
    : > "$stderr_log"

    read_requirements_file_exact "$requirements_file" "$deps_file"
    req_sha="$(file_sha256 "$requirements_file")"
    collect_freeze_file "$prod_env" "$pre_file"
    cp "$pre_file" "$post_file"
    started_at="$(timestamp_utc)"
    run_exit_code=0
    status="running"

    if ! (
        set_dependency_group_exact "$workdir" "core" "$deps_file"
        lock_project_exact "$workdir" "$py"
    ) >"$lock_log" 2>&1; then
        conflict_report="$(write_conflict_report "$txid" "core" "$lock_log")"
        ended_at="$(timestamp_utc)"
        write_update_tx_file "$TX_FILE" "$txid" "needs_resolution" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "-1" "$(core_packages_csv)" "$requirements_file" "$req_sha" "$workdir" "$deps_file"
        tx_set_conflict "$TX_FILE" "$conflict_report" "needs_resolution" "false"
        rm -f "$deps_file"
        echo "Core update blocked by lock conflict."
        echo "  txid: $txid"
        echo "  conflict_report: $conflict_report"
        exit 2
    fi

    if files_are_identical "$PROJECT_FILE" "$workdir/pyproject.toml" && files_are_identical "$LOCK_FILE" "$workdir/uv.lock"; then
        rm -rf "$workdir" "$candidate_env"
        rm -f "$deps_file" "$pre_file" "$post_file" "$stdout_log" "$stderr_log"
        echo "No changes; requirements already match local truth."
        return 0
    fi

    write_update_tx_file "$TX_FILE" "$txid" "$status" "$started_at" "" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "-1" "$(core_packages_csv)" "$requirements_file" "$req_sha" "$workdir" "$deps_file"

    if ! sync_project_env_exact "$workdir" "$candidate_env" "$py" >"$stdout_log" 2>"$stderr_log"; then
        ended_at="$(timestamp_utc)"
        collect_freeze_file "$candidate_env" "$post_file"
        write_update_tx_file "$TX_FILE" "$txid" "failed" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "3" "$(core_packages_csv)" "$requirements_file" "$req_sha" "$workdir" "$deps_file"
        rm -f "$deps_file"
        echo "Core update transaction recorded."
        echo "  txid: $txid"
        echo "  status: failed"
        return 1
    fi

    comfyui_dir="$(comfyui_dir_path)"
    main_py="${comfyui_dir}/main.py"
    set +e
    if [ -f "$main_py" ]; then
        if command -v timeout >/dev/null 2>&1; then
            timeout "${timeout_sec}s" "$candidate_env/bin/python" "$main_py" >>"$stdout_log" 2>>"$stderr_log"
            run_exit_code=$?
        else
            "$candidate_env/bin/python" "$main_py" >>"$stdout_log" 2>>"$stderr_log"
            run_exit_code=$?
        fi
    else
        echo "ComfyUI entry not found: $main_py" >>"$stderr_log"
        run_exit_code=2
    fi
    set -e

    collect_freeze_file "$candidate_env" "$post_file"
    ended_at="$(timestamp_utc)"
    status="completed"
    if [ "$run_exit_code" -ne 0 ]; then
        status="failed"
    fi

    write_update_tx_file "$TX_FILE" "$txid" "$status" "$started_at" "$ended_at" "$candidate_env" "$pre_file" "$post_file" "$stdout_log" "$stderr_log" "$run_exit_code" "$(core_packages_csv)" "$requirements_file" "$req_sha" "$workdir" "$deps_file"
    rm -f "$deps_file"

    echo "Core update transaction recorded."
    echo "  txid: $txid"
    echo "  status: $status"
}

cmd_update_inspect() {
    local txid="${1:-}"
    if [ -z "$txid" ]; then
        echo "Usage: gov update inspect <txid>" >&2
        exit 1
    fi

    load_tx "$txid"
    tx_assert_kind "core_update"

    require_python
    "${PYTHON_BIN}" - "$TX_FILE" <<'PY'
import json
import pathlib
import sys

tx = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
print(f"txid: {tx.get('txid')}")
print(f"kind: {tx.get('kind')}")
print(f"status: {tx.get('status')}")
print(f"started_at: {tx.get('started_at')}")
print(f"ended_at: {tx.get('ended_at')}")
print(f"candidate_env: {tx.get('candidate_env')}")
print(f"source_requirements_path: {tx.get('source_requirements_path')}")
print(f"source_requirements_sha256: {tx.get('source_requirements_sha256')}")
print(f"staged_workdir: {tx.get('staged_workdir')}")
print(f"target_core_deps: {len(tx.get('target_core_deps', []))}")
diff = tx.get("diff", {})
print(f"added_count: {len(diff.get('added', []))}")
print(f"removed_count: {len(diff.get('removed', []))}")
core = tx.get("core_impact", [])
print(f"core_impact: {', '.join(core) if core else '(none)'}")
print(f"conflict_report: {tx.get('conflict_report') or '(none)'}")
print(f"resolution_pins: {len(tx.get('resolution_pins', []))}")
prom = tx.get("promotion", {})
print(f"promotion_status: {prom.get('status') or '(none)'}")
logs = tx.get("logs", {})
print(f"stdout_log: {logs.get('stdout', '')}")
print(f"stderr_log: {logs.get('stderr', '')}")
print(f"run_exit_code: {logs.get('run_exit_code', '')}")
PY
}

cmd_update_resolve() {
    require_cmd uv
    require_python
    ensure_layout

    local txid="${1:-}"
    shift || true
    if [ -z "$txid" ]; then
        echo "Usage: gov update resolve <txid> [--pin <pkg==version>]... [--pins-file <path>]" >&2
        exit 1
    fi

    local pin_values=()
    local pins_file_path=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --pin)
                pin_values+=("${2:-}")
                shift 2
                ;;
            --pins-file)
                pins_file_path="${2:-}"
                shift 2
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ "${#pin_values[@]}" -eq 0 ] && [ -z "$pins_file_path" ]; then
        echo "ERROR: provide --pin <pkg==version> and/or --pins-file <path>" >&2
        exit 1
    fi

    load_tx "$txid"
    tx_assert_kind "core_update"

    local status staged_workdir py
    status="$(tx_get_field "$TX_FILE" "status" "")"
    staged_workdir="$(tx_get_field "$TX_FILE" "staged_workdir" "")"
    py="$(configured_python)"

    case "$status" in
        needs_resolution|promote_failed|resolved)
            ;;
        *)
            echo "ERROR: tx status '$status' is not resolvable" >&2
            exit 1
            ;;
    esac

    if [ -z "$staged_workdir" ] || [ ! -d "$staged_workdir" ]; then
        echo "ERROR: staged workdir missing for tx=$txid" >&2
        exit 1
    fi

    local new_pins merged_pins pin lock_log report
    new_pins="$(mktemp)"
    merged_pins="$(mktemp)"
    lock_log="${CONFLICT_DIR}/${txid}.update.resolve.lock.log"

    for pin in "${pin_values[@]}"; do
        if [[ ! "$pin" =~ ^[A-Za-z0-9_.-]+==[^[:space:]]+$ ]]; then
            echo "ERROR: invalid pin format: $pin" >&2
            rm -f "$new_pins" "$merged_pins"
            exit 1
        fi
        echo "$pin" >> "$new_pins"
    done

    if [ -n "$pins_file_path" ]; then
        if [ ! -f "$pins_file_path" ]; then
            echo "ERROR: pins file not found: $pins_file_path" >&2
            rm -f "$new_pins" "$merged_pins"
            exit 1
        fi
        while IFS= read -r pin; do
            pin="$(echo "$pin" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
            [ -z "$pin" ] && continue
            if [[ ! "$pin" =~ ^[A-Za-z0-9_.-]+==[^[:space:]]+$ ]]; then
                echo "ERROR: invalid pin format: $pin" >&2
                rm -f "$new_pins" "$merged_pins"
                exit 1
            fi
            echo "$pin" >> "$new_pins"
        done < "$pins_file_path"
    fi

    "${PYTHON_BIN}" - "$TX_FILE" "$new_pins" "$merged_pins" <<'PY'
import json
import pathlib
import sys

tx = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
new_pins = pathlib.Path(sys.argv[2])
out = pathlib.Path(sys.argv[3])

extra = []
if new_pins.exists():
    extra = [x.strip() for x in new_pins.read_text(encoding="utf-8").splitlines() if x.strip()]

seen = set()
merged = []
for item in tx.get("resolution_pins", []) + extra:
    if item not in seen:
        seen.add(item)
        merged.append(item)

out.write_text("\n".join(merged) + ("\n" if merged else ""), encoding="utf-8")
PY

    if ! (
        append_pins_to_overrides_group "$staged_workdir" "$merged_pins"
        lock_project_exact "$staged_workdir" "$py"
    ) >"$lock_log" 2>&1; then
        report="$(write_conflict_report "$txid" "core" "$lock_log")"
        tx_set_resolution_pins "$TX_FILE" "$merged_pins" "needs_resolution"
        tx_set_conflict "$TX_FILE" "$report" "needs_resolution" "false"
        rm -f "$new_pins" "$merged_pins"
        echo "Resolve failed."
        echo "  txid: $txid"
        echo "  conflict_report: $report"
        exit 2
    fi

    tx_set_resolution_pins "$TX_FILE" "$merged_pins" "resolved"
    tx_set_conflict "$TX_FILE" "" "resolved" "false"

    rm -f "$new_pins" "$merged_pins"
    echo "Resolve succeeded."
    echo "  txid: $txid"
    echo "  status: resolved"
}

cmd_update_promote() {
    require_cmd uv
    require_python
    ensure_layout

    local txid="${1:-}"
    shift || true
    if [ -z "$txid" ]; then
        echo "Usage: gov update promote <txid> [--approve-core --reason \"...\"] [--allow-failed-run]" >&2
        exit 1
    fi

    local approve_core=false
    local reason=""
    local allow_failed_run=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --approve-core)
                approve_core=true
                shift
                ;;
            --reason)
                reason="${2:-}"
                shift 2
                ;;
            --allow-failed-run)
                allow_failed_run=true
                shift
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    load_tx "$txid"
    tx_assert_kind "core_update"

    local status core_count staged_workdir py op_id prod_env comfyui_dir
    status="$(tx_get_field "$TX_FILE" "status" "")"
    core_count="$(tx_get_field "$TX_FILE" "core_impact" "" | sed '/^$/d' | wc -l | tr -d ' ')"
    staged_workdir="$(tx_get_field "$TX_FILE" "staged_workdir" "")"
    py="$(configured_python)"

    case "$status" in
        completed|resolved)
            ;;
        failed)
            if [ "$allow_failed_run" != true ]; then
                echo "ERROR: tx status is failed. Use --allow-failed-run to continue." >&2
                exit 1
            fi
            ;;
        *)
            echo "ERROR: tx status '$status' cannot be promoted" >&2
            exit 1
            ;;
    esac

    if [ "$core_count" != "0" ] && [ "$approve_core" != true ]; then
        echo "ERROR: core package impact detected. Use --approve-core to continue." >&2
        exit 1
    fi

    if [ -z "$staged_workdir" ] || [ ! -d "$staged_workdir" ]; then
        echo "ERROR: staged workdir missing for tx=$txid" >&2
        exit 1
    fi

    op_id="$(op_begin "update_promote" "$txid")"
    cp "$staged_workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$staged_workdir/uv.lock" "$LOCK_FILE"

    prod_env="$(prod_env_path)"
    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed during update promote, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        tx_set_promote_failed "$TX_FILE" "$op_id" "prod sync failed"
        op_finalize "$op_id" "failed" "false" "update promote failed: prod sync failed"
        exit 1
    fi

    comfyui_dir="$(comfyui_dir_path)"
    if ! run_smoke_test_in_env "$prod_env" "$comfyui_dir"; then
        echo "ERROR: smoke test failed during update promote, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        tx_set_promote_failed "$TX_FILE" "$op_id" "smoke test failed"
        op_finalize "$op_id" "failed" "false" "update promote failed: smoke test failed"
        exit 1
    fi

    tx_set_promoted "$TX_FILE" "$op_id" "$reason"
    op_finalize "$op_id" "success" "true" "update promote succeeded"
    ops_prune

    echo "Core update promoted."
    echo "  txid: $txid"
    echo "  op_id: $op_id"
}

cmd_update_abort() {
    local txid="${1:-}"
    if [ -z "$txid" ]; then
        echo "Usage: gov update abort <txid>" >&2
        exit 1
    fi
    _cmd_abort_impl "$txid" "core_update" "Core update"
}

env_import_restore_after_failure() {
    local op_id="$1"
    local comfyui_dir="$2"
    local restore_py="$3"

    bundle_restore_config "$op_id" || true
    bundle_restore_custom_nodes "$op_id" "$comfyui_dir" || true
    op_restore_backup "$op_id" || true

    local prod_env
    prod_env="$(prod_env_path)"
    if [ -f "$PROJECT_FILE" ]; then
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$restore_py" || true
    else
        rm -rf "$prod_env"
    fi
}

cmd_env_export() {
    require_cmd uv
    ensure_layout

    local output_dir="${1:-}"
    if [ -z "$output_dir" ]; then
        echo "Usage: gov env export <output_dir>" >&2
        exit 1
    fi

    if [ ! -f "$PROJECT_FILE" ]; then
        echo "ERROR: missing $PROJECT_FILE" >&2
        exit 1
    fi
    if [ ! -f "$LOCK_FILE" ]; then
        echo "ERROR: missing $LOCK_FILE" >&2
        exit 1
    fi
    if [ ! -f "$PLUGINS_FILE" ]; then
        echo "ERROR: missing $PLUGINS_FILE" >&2
        exit 1
    fi
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "ERROR: missing $CONFIG_FILE" >&2
        exit 1
    fi

    local comfyui_dir
    comfyui_dir="$(comfyui_dir_path)"
    if [ ! -d "$comfyui_dir" ]; then
        echo "ERROR: ComfyUI directory not found: $comfyui_dir" >&2
        exit 1
    fi

    if [ -e "$output_dir" ] && [ ! -d "$output_dir" ]; then
        echo "ERROR: export path exists and is not a directory: $output_dir" >&2
        exit 1
    fi
    if [ -d "$output_dir" ] && [ -n "$(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
        echo "ERROR: export directory is not empty: $output_dir" >&2
        exit 1
    fi

    mkdir -p "$output_dir/state" "$output_dir/audit" "$output_dir/custom_nodes"

    cp "$PROJECT_FILE" "$output_dir/pyproject.toml"
    cp "$LOCK_FILE" "$output_dir/uv.lock"
    cp "$PLUGINS_FILE" "$output_dir/state/plugins.json"
    bundle_export_pylock "$output_dir"
    bundle_copy_custom_nodes "$output_dir" "$comfyui_dir" "$PLUGINS_FILE"

    local prod_env created_at node_count
    prod_env="$(prod_env_path)"
    collect_freeze_file "$prod_env" "$output_dir/audit/prod-freeze.txt"
    created_at="$(timestamp_utc)"
    bundle_write_export_summary "$output_dir" "$created_at"
    bundle_manifest_write "$output_dir" "$created_at"
    node_count="$(bundle_node_count "$output_dir/state/plugins.json")"

    echo "Environment bundle exported."
    echo "  output_dir: $output_dir"
    echo "  python: $(configured_python)"
    echo "  node_count: $node_count"
    echo "  manifest: $output_dir/manifest.json"
}

cmd_env_import() {
    require_cmd uv

    local bundle_dir="${1:-}"
    shift || true
    if [ -z "$bundle_dir" ]; then
        echo "Usage: gov env import <bundle_dir> --comfyui-dir <abs-path> --python <python-spec>" >&2
        exit 1
    fi

    local comfyui_dir=""
    local python_spec=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --comfyui-dir)
                comfyui_dir="${2:-}"
                shift 2
                ;;
            --python)
                python_spec="${2:-}"
                shift 2
                ;;
            *)
                echo "Unknown argument: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$comfyui_dir" ] || [ -z "$python_spec" ]; then
        echo "Usage: gov env import <bundle_dir> --comfyui-dir <abs-path> --python <python-spec>" >&2
        exit 1
    fi

    local normalized_python
    normalized_python="$(resolve_python_minor "$python_spec")"

    bundle_manifest_verify "$bundle_dir"
    bundle_check_runtime_compatibility "$bundle_dir" "$normalized_python"

    local pre_restore_py current_prod_env
    pre_restore_py="$(config_get "runtime.python" "$normalized_python")"
    current_prod_env="$(prod_env_path)"
    bundle_check_import_conflicts "$bundle_dir" "$comfyui_dir"

    local op_id
    op_id="$(op_begin "env_import" "$bundle_dir")"
    bundle_backup_config "$op_id"
    bundle_backup_custom_nodes "$bundle_dir" "$op_id" "$comfyui_dir"

    local workdir
    workdir="${WORK_DIR}/env-import-${op_id}"
    rm -rf "$workdir"
    mkdir -p "$workdir"
    bundle_stage_truth "$bundle_dir" "$workdir"

    if ! bundle_lock_check "$workdir" "$normalized_python"; then
        echo "ERROR: bundle lock check failed" >&2
        env_import_restore_after_failure "$op_id" "$comfyui_dir" "$pre_restore_py"
        op_finalize "$op_id" "failed" "false" "env import failed: bundle lock check failed"
        exit 1
    fi

    if ! sync_project_env_exact "$workdir" "$current_prod_env" "$normalized_python"; then
        echo "ERROR: prod sync failed during env import" >&2
        env_import_restore_after_failure "$op_id" "$comfyui_dir" "$pre_restore_py"
        op_finalize "$op_id" "failed" "false" "env import failed: prod sync failed"
        exit 1
    fi

    if ! bundle_apply_custom_nodes "$bundle_dir" "$comfyui_dir"; then
        echo "ERROR: failed to restore custom_nodes payload" >&2
        env_import_restore_after_failure "$op_id" "$comfyui_dir" "$pre_restore_py"
        op_finalize "$op_id" "failed" "false" "env import failed: custom_nodes restore failed"
        exit 1
    fi

    cp "${workdir}/pyproject.toml" "$PROJECT_FILE"
    cp "${workdir}/uv.lock" "$LOCK_FILE"
    bundle_restore_plugins_registry "$bundle_dir"

    if ! ensure_config_file_for_init "$comfyui_dir" "$normalized_python"; then
        echo "ERROR: failed to update config.toml during env import" >&2
        env_import_restore_after_failure "$op_id" "$comfyui_dir" "$pre_restore_py"
        op_finalize "$op_id" "failed" "false" "env import failed: config update failed"
        exit 1
    fi

    local final_prod_env
    final_prod_env="$(prod_env_path)"
    if ! run_smoke_test_in_env "$final_prod_env" "$comfyui_dir"; then
        echo "ERROR: smoke test failed during env import" >&2
        env_import_restore_after_failure "$op_id" "$comfyui_dir" "$pre_restore_py"
        op_finalize "$op_id" "failed" "false" "env import failed: smoke test failed"
        exit 1
    fi

    op_finalize "$op_id" "success" "false" "env import succeeded"
    ops_prune

    echo "Environment bundle imported."
    echo "  bundle_dir: $bundle_dir"
    echo "  comfyui_dir: $comfyui_dir"
    echo "  python: $normalized_python"
    echo "  op_id: $op_id"
}

cmd_status() {
    ensure_layout
    local prod_env
    prod_env="$(prod_env_path)"
    require_python
    "${PYTHON_BIN}" - "$CONFIG_FILE" "$PROJECT_FILE" "$prod_env" "$LOCK_FILE" "$TX_DIR" <<'PY'
import json
import pathlib
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

config_file = pathlib.Path(sys.argv[1])
project_file = pathlib.Path(sys.argv[2])
prod_env = pathlib.Path(sys.argv[3])
lock_file = pathlib.Path(sys.argv[4])
tx_dir = pathlib.Path(sys.argv[5])

def load_toml(path: pathlib.Path):
    if not path.exists():
        return {}
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}

cfg = load_toml(config_file)
project = load_toml(project_file)
groups = project.get("dependency-groups", {}) if isinstance(project, dict) else {}
if not isinstance(groups, dict):
    groups = {}

def normalize_name(spec: str) -> str:
    token = re.split(r"[<>=!~;\[]", spec, maxsplit=1)[0].strip()
    if "@" in token:
        token = token.split("@", 1)[0].strip()
    return re.sub(r"[-_.]+", "-", token).lower()

torch_group = groups.get("torch", [])
core_group = groups.get("core", [])
if not isinstance(torch_group, list):
    torch_group = []
if not isinstance(core_group, list):
    core_group = []

torch_names = {normalize_name(str(item)) for item in torch_group if str(item).strip()}
torch_ready = {"torch", "torchvision", "torchaudio"}.issubset(torch_names)
core_ready = bool([str(item).strip() for item in core_group if str(item).strip()])

comfyui_dir = ""
runtime_python = ""
if isinstance(cfg, dict):
    comfyui_dir = str((cfg.get("paths") or {}).get("comfyui_dir") or "")
    runtime_python = str((cfg.get("runtime") or {}).get("python") or "")
config_ready = bool(comfyui_dir and runtime_python)

records = []
for f in sorted(tx_dir.glob("*.json")):
    try:
        records.append(json.loads(f.read_text(encoding="utf-8")))
    except Exception:
        continue

pending_status = {
    "running",
    "completed",
    "failed",
    "needs_resolution",
    "resolved",
    "promote_failed",
}
pending = [x for x in records if x.get("status") in pending_status]
pending_updates = [x for x in records if x.get("kind", "plugin") == "core_update" and x.get("status") in pending_status]
recent = sorted(records, key=lambda x: x.get("started_at", ""), reverse=True)[:8]

print("Comfy Env Status")
print(f"config_ready: {'yes' if config_ready else 'no'}")
print(f"comfyui_dir: {comfyui_dir or '(unset)'}")
print(f"python: {runtime_python or '(unset)'}")
print(f"prod_env_exists: {'yes' if prod_env.exists() else 'no'}")
print(f"lock_exists: {'yes' if lock_file.exists() else 'no'}")
print(f"torch_ready: {'yes' if torch_ready else 'no'}")
print(f"core_ready: {'yes' if core_ready else 'no'}")
print(f"transactions_total: {len(records)}")
print(f"transactions_pending: {len(pending)}")
print(f"update_transactions_pending: {len(pending_updates)}")
print("recent_transactions:")
if not recent:
    print("  (none)")
else:
    for item in recent:
        kind = item.get("kind", "plugin")
        subject = item.get("subject") or item.get("node_id") or "(unknown)"
        print(f"  - {item.get('txid')} [{item.get('status')}] kind={kind} subject={subject}")
PY
}

apply_staged_pin_change() {
    local workdir="$1"
    local op_kind="$2"
    local op_ref="$3"
    local success_note="$4"
    local action_label="$5"

    local py prod_env comfyui_dir op_id
    py="$(configured_python)"
    prod_env="$(prod_env_path)"
    comfyui_dir="$(comfyui_dir_path)"
    op_id="$(op_begin "$op_kind" "$op_ref")"

    cp "$workdir/pyproject.toml" "$PROJECT_FILE"
    cp "$workdir/uv.lock" "$LOCK_FILE"

    if ! sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py"; then
        echo "ERROR: prod sync failed during ${action_label}, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "${action_label} failed: prod sync failed"
        return 1
    fi

    if ! run_smoke_test_in_env "$prod_env" "$comfyui_dir"; then
        echo "ERROR: smoke test failed during ${action_label}, restoring pre-operation state: $op_id" >&2
        op_restore_backup "$op_id"
        sync_project_env_exact "$ROOT_DIR" "$prod_env" "$py" || true
        op_finalize "$op_id" "failed" "false" "${action_label} failed: smoke test failed"
        return 1
    fi

    op_finalize "$op_id" "success" "true" "$success_note"
    ops_prune

    echo "$op_id"
}

cmd_pin_list() {
    ensure_layout
    require_python

    if [ $# -ne 0 ]; then
        echo "Usage: gov pin list" >&2
        exit 1
    fi

    local pins_file
    pins_file="$(mktemp)"
    write_group_deps "$PROJECT_FILE" "overrides" "$pins_file"

    if [ ! -s "$pins_file" ]; then
        rm -f "$pins_file"
        echo "No pins in overrides group."
        return 0
    fi

    cat "$pins_file"
    rm -f "$pins_file"
}

cmd_pin_add() {
    require_cmd uv
    ensure_layout
    ensure_project_file_for_init
    require_python

    local -a specs=()
    local -a deduped_specs=()
    local -a present_target_names=()
    local spec dep_name

    while [ $# -gt 0 ]; do
        specs+=("$1")
        shift
    done

    if [ "${#specs[@]}" -eq 0 ]; then
        echo "Usage: gov pin add <pkg==version>..." >&2
        exit 1
    fi

    for spec in "${specs[@]}"; do
        if [[ ! "$spec" =~ ^[A-Za-z0-9_.-]+==[^[:space:]]+$ ]]; then
            echo "ERROR: invalid pin format: $spec (expected pkg==version)" >&2
            exit 1
        fi
        dep_name="$(normalize_dep_name "$spec")"
        if [ -z "$dep_name" ]; then
            echo "ERROR: invalid pin format: $spec (expected pkg==version)" >&2
            exit 1
        fi
        if torch_family_dep_name_is_managed "$dep_name"; then
            echo "ERROR: torch-family packages are managed by 'gov install torch'. Use 'gov install torch --index-url <url> [--torch <torch==version>] [--torchvision <torchvision==version>] [--torchaudio <torchaudio==version>]' instead." >&2
            exit 1
        fi
    done

    local deduped_specs_file
    deduped_specs_file="$(mktemp)"
    write_pin_specs_last_wins "$deduped_specs_file" "${specs[@]}"
    mapfile -t deduped_specs < "$deduped_specs_file"
    rm -f "$deduped_specs_file"

    warn_for_unrecommended_pin_specs "${deduped_specs[@]}"

    local workdir py op_id present_names_file
    workdir="$(build_workdir_for_tx "pin-add-$(_random_hex8)")"
    py="$(configured_python)"
    present_names_file="$(mktemp)"

    write_group_names_matching_specs "$workdir/pyproject.toml" "overrides" "$present_names_file" "${deduped_specs[@]}"
    mapfile -t present_target_names < "$present_names_file"
    rm -f "$present_names_file"

    if ! (
        cd "$workdir"
        if [ "${#present_target_names[@]}" -ne 0 ]; then
            uv remove --group overrides --python "$py" --frozen "${present_target_names[@]}"
        fi
        uv add --group overrides --python "$py" --frozen "${deduped_specs[@]}"
    ); then
        echo "ERROR: pin add failed while updating overrides" >&2
        exit 1
    fi
    if ! lock_project_exact "$workdir" "$py"; then
        echo "ERROR: pin add failed during lock" >&2
        exit 1
    fi

    op_id="$(apply_staged_pin_change "$workdir" "pin_add" "${deduped_specs[*]}" "pin add succeeded: ${deduped_specs[*]}" "pin add")" || {
        exit 1
    }

    echo "Pins added."
    echo "  specs: ${deduped_specs[*]}"
    echo "  op_id: $op_id"
}

cmd_pin_remove() {
    require_cmd uv
    ensure_layout
    ensure_project_file_for_init
    require_python

    local -a packages=()
    local -a normalized_packages=()
    local pkg dep_name existing seen

    while [ $# -gt 0 ]; do
        packages+=("$1")
        shift
    done

    if [ "${#packages[@]}" -eq 0 ]; then
        echo "Usage: gov pin remove <pkg>..." >&2
        exit 1
    fi

    for pkg in "${packages[@]}"; do
        if [[ ! "$pkg" =~ ^[A-Za-z0-9_.-]+$ ]]; then
            echo "ERROR: invalid package name: $pkg" >&2
            exit 1
        fi
        dep_name="$(normalize_dep_name "$pkg")"
        if [ -z "$dep_name" ]; then
            echo "ERROR: invalid package name: $pkg" >&2
            exit 1
        fi
        if torch_family_dep_name_is_managed "$dep_name"; then
            echo "ERROR: torch-family packages are managed by 'gov install torch'. Use 'gov install torch --index-url <url> [--torch <torch==version>] [--torchvision <torchvision==version>] [--torchaudio <torchaudio==version>]' instead." >&2
            exit 1
        fi
        seen=false
        for existing in "${normalized_packages[@]}"; do
            if [ "$existing" = "$dep_name" ]; then
                seen=true
                break
            fi
        done
        if [ "$seen" != true ]; then
            normalized_packages+=("$dep_name")
        fi
    done

    local workdir py op_id
    workdir="$(build_workdir_for_tx "pin-remove-$(_random_hex8)")"
    py="$(configured_python)"

    if ! (
        cd "$workdir"
        uv remove --group overrides --python "$py" --frozen "${normalized_packages[@]}"
    ); then
        exit 1
    fi

    if ! lock_project_exact "$workdir" "$py"; then
        echo "ERROR: pin remove failed during lock" >&2
        exit 1
    fi

    op_id="$(apply_staged_pin_change "$workdir" "pin_remove" "${packages[*]}" "pin remove succeeded: ${packages[*]}" "pin remove")" || {
        exit 1
    }

    echo "Pins removed."
    echo "  packages: ${packages[*]}"
    echo "  op_id: $op_id"
}

cmd_run() {
    ensure_layout

    local sync_before=false
    local comfyui_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --sync)
                sync_before=true
                shift
                ;;
            --)
                shift
                comfyui_args=("$@")
                break
                ;;
            *)
                comfyui_args+=("$1")
                shift
                ;;
        esac
    done

    local cfg_sync
    cfg_sync="$(config_get "run.sync_before_run" "false")"
    if [ "$cfg_sync" = "true" ]; then
        sync_before=true
    fi

    local prod_env comfyui_dir main_py
    prod_env="$(prod_env_path)"
    comfyui_dir="$(comfyui_dir_path)"
    main_py="${comfyui_dir}/main.py"

    if [ ! -d "$prod_env" ]; then
        echo "ERROR: prod environment not found: $prod_env" >&2
        echo "Hint: run 'gov init' to create the production environment." >&2
        exit 1
    fi

    if [ ! -f "$LOCK_FILE" ]; then
        echo "ERROR: uv.lock not found. Run 'gov init' first." >&2
        exit 1
    fi

    if [ ! -f "$main_py" ]; then
        echo "ERROR: ComfyUI entry not found: $main_py" >&2
        exit 1
    fi

    if [ "$sync_before" = true ]; then
        require_cmd uv
        echo "Syncing prod environment..."
        sync_project_env_exact "$ROOT_DIR" "$prod_env"
    fi

    local extra_args
    extra_args="$(config_get "run.extra_args" "")"

    echo "$$" > "$PID_FILE"

    echo "Starting ComfyUI with prod environment..."
    echo "  python: $prod_env/bin/python"
    echo "  entry:  $main_py"
    echo "  pid:    $$"

    if [ ${#comfyui_args[@]} -gt 0 ]; then
        exec "$prod_env/bin/python" "$main_py" "${comfyui_args[@]}"
    elif [ -n "$extra_args" ]; then
        # Word splitting on purpose to pass args
        # shellcheck disable=SC2086
        exec "$prod_env/bin/python" "$main_py" $extra_args
    else
        exec "$prod_env/bin/python" "$main_py"
    fi
}

cmd_stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo "ERROR: PID file not found: $PID_FILE" >&2
        echo "ComfyUI might not be running via 'gov run'." >&2
        exit 1
    fi

    local pid
    pid="$(cat "$PID_FILE")"
    
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Process $pid is not running. Cleaning up stale PID file."
        rm -f "$PID_FILE"
        exit 0
    fi

    echo "Stopping ComfyUI (PID: $pid)..."
    kill -TERM "$pid"

    local wait_time=0
    local max_wait=30
    while kill -0 "$pid" 2>/dev/null; do
        sleep 1
        wait_time=$((wait_time + 1))
        if [ "$wait_time" -ge "$max_wait" ]; then
            echo "Timeout reached. Force killing process $pid..."
            kill -KILL "$pid" 2>/dev/null || true
            break
        fi
    done

    rm -f "$PID_FILE"
    echo "ComfyUI stopped."
}

cmd_help() {
    cat <<'EOF'
Comfy Env Governance CLI (Batch-4)

Usage:
  gov init --comfyui-dir <abs-path> --python <python-spec>
  gov install [--requirements-file <path>]
  gov install torch --index-url <url> [--torch <torch==version>] [--torchvision <torchvision==version>] [--torchaudio <torchaudio==version>]
  gov pin add <pkg==version>...
  gov pin list
  gov pin remove <pkg>...
  gov update run [--requirements-file <path>] [--timeout <seconds>]
  gov update inspect <txid>
  gov update resolve <txid> [--pin <pkg==version>]... [--pins-file <path>]
  gov update promote <txid> [--approve-core --reason "..."] [--allow-failed-run]
  gov update abort <txid>
  gov env export <output_dir>
  gov env import <bundle_dir> --comfyui-dir <abs-path> --python <python-spec>
  gov node add <git_url> [--ref <sha/tag>] [--id <node_id>]
  gov node remove <node_id> [--purge-code]
  gov tx run <node_id> [--timeout <seconds>]
  gov tx inspect <txid>
  gov tx abort <txid>
  gov tx promote <txid> [--approve-core --reason "..."] [--allow-failed-run]
  gov resolve <txid>
  gov undo <op_id>
  gov op list
  gov op inspect <op_id>
  gov status
  gov run [--sync] [-- <args...>]
  gov stop

Notes:
  - Operation backups are stored in state/ops/<op_id>/backup.
  - Undo requires current file hashes to match target operation post hashes.
  - Ops retention defaults to 100.
  - Resolve pins are persisted in dependency-groups.overrides.
  - Initial setup is: init -> install torch -> install.
EOF
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        init)
            shift
            cmd_init "$@"
            ;;
        install)
            shift
            case "${1:-}" in
                torch)
                    shift
                    cmd_install_torch "$@"
                    ;;
                *)
                    cmd_install_core "$@"
                    ;;
            esac
            ;;
        pin)
            shift
            case "${1:-}" in
                add)
                    shift
                    cmd_pin_add "$@"
                    ;;
                list)
                    shift
                    cmd_pin_list "$@"
                    ;;
                remove)
                    shift
                    cmd_pin_remove "$@"
                    ;;
                *)
                    echo "Usage: gov pin {add|list|remove} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        update)
            shift
            case "${1:-}" in
                run)
                    shift
                    cmd_update_run "$@"
                    ;;
                inspect)
                    shift
                    cmd_update_inspect "$@"
                    ;;
                resolve)
                    shift
                    cmd_update_resolve "$@"
                    ;;
                promote)
                    shift
                    cmd_update_promote "$@"
                    ;;
                abort)
                    shift
                    cmd_update_abort "$@"
                    ;;
                *)
                    echo "Usage: gov update {run|inspect|resolve|promote|abort} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        env)
            shift
            case "${1:-}" in
                export)
                    shift
                    cmd_env_export "$@"
                    ;;
                import)
                    shift
                    cmd_env_import "$@"
                    ;;
                *)
                    echo "Usage: gov env {export|import} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        node)
            shift
            case "${1:-}" in
                add)
                    shift
                    cmd_node_add "$@"
                    ;;
                remove)
                    shift
                    cmd_node_remove "$@"
                    ;;
                *)
                    echo "Usage: gov node {add|remove} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        tx)
            shift
            case "${1:-}" in
                run)
                    shift
                    cmd_tx_run "$@"
                    ;;
                inspect)
                    shift
                    cmd_tx_inspect "$@"
                    ;;
                abort)
                    shift
                    cmd_tx_abort "$@"
                    ;;
                promote)
                    shift
                    cmd_tx_promote "$@"
                    ;;
                *)
                    echo "Usage: gov tx {run|inspect|abort|promote} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        resolve)
            shift
            cmd_resolve "$@"
            ;;
        undo)
            shift
            cmd_undo "$@"
            ;;
        op)
            shift
            case "${1:-}" in
                list)
                    shift
                    cmd_op_list "$@"
                    ;;
                inspect)
                    shift
                    cmd_op_inspect "$@"
                    ;;
                *)
                    echo "Usage: gov op {list|inspect} ..." >&2
                    exit 1
                    ;;
            esac
            ;;
        status)
            shift
            cmd_status "$@"
            ;;
        run)
            shift
            cmd_run "$@"
            ;;
        stop)
            shift
            cmd_stop "$@"
            ;;
        ""|-h|--help|help)
            cmd_help
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
